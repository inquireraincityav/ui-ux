---
interface PoseSet {
  front: string;
  left?: string;
  right?: string;
  wave?: string;
  back?: string;
}
interface Props {
  size?: number;
  alt?: string;
  poses?: PoseSet;
}
const { size = 320, alt = 'Jaival Shah', poses } = Astro.props;
---
<div class="character-stage" style={`--char-size:${size}px`}>
  <div class="character-float">
    <div class="character-tilt" data-parallax>
      <div class="char-poses" data-poses={poses ? JSON.stringify(poses) : '{}'}>
        {poses && Object.entries(poses).map(([key, url]) => (
          <img
            src={url}
            alt={key === 'front' ? alt : ''}
            class:list={["pose", `pose-${key}`, { active: key === 'front' }]}
            loading="eager"
            draggable="false"
          />
        ))}
      </div>
    </div>
  </div>
  <div class="character-shadow" aria-hidden="true"></div>
</div>

<script>
  document.querySelectorAll<HTMLDivElement>('[data-parallax]').forEach((tilt) => {
    const stage = tilt.closest('.character-stage') as HTMLElement;
    if (!stage) return;

    const posesEl = tilt.querySelector('.char-poses') as HTMLDivElement;
    const poses = JSON.parse(posesEl?.dataset.poses || '{}');
    const imgs = posesEl?.querySelectorAll<HTMLImageElement>('.pose') || [];
    let current = 'front';
    let rafId = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    function show(name: string) {
      if (name === current || !poses[name]) return;
      imgs.forEach((img) => {
        const key = img.classList[1]?.replace('pose-', '');
        img.classList.toggle('active', key === name);
      });
      current = name;
    }

    function lerp(a: number, b: number, t: number) {
      return a + (b - a) * t;
    }

    function animate() {
      currentX = lerp(currentX, targetX, 0.08);
      currentY = lerp(currentY, targetY, 0.08);
      tilt.style.transform =
        `perspective(800px) rotateY(${currentX * 8}deg) rotateX(${currentY * -4}deg)`;
      rafId = requestAnimationFrame(animate);
    }

    rafId = requestAnimationFrame(animate);

    document.addEventListener('mousemove', (e) => {
      const rect = stage.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      targetX = (e.clientX - cx) / (window.innerWidth / 2);
      targetY = (e.clientY - cy) / (window.innerHeight / 2);
      targetX = Math.max(-1, Math.min(1, targetX));
      targetY = Math.max(-1, Math.min(1, targetY));

      if (!stage.matches(':hover')) {
        const x = e.clientX / window.innerWidth;
        if (x < 0.3 && poses.left) show('left');
        else if (x > 0.7 && poses.right) show('right');
        else show('front');
      }
    });

    stage.addEventListener('mouseenter', () => {
      if (poses.wave) show('wave');
    });
    stage.addEventListener('mouseleave', () => {
      show('front');
      targetX = 0;
      targetY = 0;
    });

    // cleanup on page leave
    document.addEventListener('astro:before-preparation', () => {
      cancelAnimationFrame(rafId);
    }, { once: true });
  });
</script>

<style>
  .character-stage {
    width: var(--char-size);
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .character-float {
    animation: char-float 5s ease-in-out infinite;
    will-change: transform;
  }

  .character-tilt {
    transition: transform 0.1s linear;
    transform-style: preserve-3d;
  }

  .char-poses {
    position: relative;
    width: var(--char-size);
    aspect-ratio: 3 / 4;
  }

  .pose {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.4s ease;
    mix-blend-mode: multiply;
    user-select: none;
    -webkit-user-drag: none;
  }
  .pose.active { opacity: 1; }

  .character-shadow {
    width: 60%;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(0,0,0,0.15) 0%, transparent 70%);
    margin-top: -8px;
    animation: shadow-pulse 5s ease-in-out infinite;
    will-change: transform, opacity;
  }

  @keyframes char-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @keyframes shadow-pulse {
    0%, 100% {
      transform: scaleX(1);
      opacity: 1;
    }
    50% {
      transform: scaleX(0.85);
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .character-float { animation: none; }
    .character-shadow { animation: none; }
    .character-tilt { transition: none; }
  }
</style>

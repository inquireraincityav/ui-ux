---
// Character component. Two modes:
//
// 1. `src` prop → renders an image (PNG/WebP with transparent bg) or a
//    <video> loop. This is the mode we'll use once we have a 3D render
//    of you. Put the file in public/character/ and pass e.g. src="/character/you.webp".
//    Optional `srcHover` swaps to a second frame on hover (a wave, a thumbs-up).
//
// 2. No `src` → falls back to a minimal SVG placeholder so the layout
//    doesn't break while we wait for the real render.
interface Props {
  size?: number;
  mood?: 'wave' | 'idle' | 'point';
  className?: string;
  src?: string;          // path to a static image or first-frame render
  srcHover?: string;     // optional second frame shown on hover
  videoSrc?: string;     // path to a short mp4/webm loop (overrides src)
  alt?: string;
}
const {
  size = 260,
  mood = 'wave',
  className = '',
  src,
  srcHover,
  videoSrc,
  alt = 'Illustrated character',
} = Astro.props;
---
<div class:list={["character", `mood-${mood}`, className, { "has-image": !!src || !!videoSrc }]} style={`--char-size:${size}px`}>
  {videoSrc ? (
    <video
      class="char-video"
      src={videoSrc}
      autoplay
      loop
      muted
      playsinline
      aria-label={alt}
    ></video>
  ) : src ? (
    <div class="char-image-wrap">
      <img class="char-img base" src={src} alt={alt} />
      {srcHover && <img class="char-img hover" src={srcHover} alt="" aria-hidden="true" />}
    </div>
  ) : (
    <svg viewBox="0 0 200 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={alt}>
      <ellipse cx="100" cy="248" rx="46" ry="6" fill="rgba(0,0,0,0.10)" />
      <g class="legs">
        <rect x="82" y="180" width="14" height="60" rx="6" fill="var(--ink-2)" />
        <rect x="104" y="180" width="14" height="60" rx="6" fill="var(--ink-2)" />
        <rect x="80" y="235" width="18" height="8" rx="3" fill="var(--ink)" />
        <rect x="102" y="235" width="18" height="8" rx="3" fill="var(--ink)" />
      </g>
      <g class="body">
        <path d="M60 120 Q100 100 140 120 L136 195 Q100 208 64 195 Z" fill="var(--ink)" />
      </g>
      <g class="arm-left">
        <path d="M64 128 Q52 160 62 190" stroke="var(--ink-2)" stroke-width="12" stroke-linecap="round" fill="none"/>
        <circle cx="62" cy="192" r="8" fill="#e6c9a8"/>
      </g>
      <g class="arm-right">
        <path d="M136 128 Q158 118 168 90" stroke="var(--ink-2)" stroke-width="12" stroke-linecap="round" fill="none"/>
        <circle cx="168" cy="88" r="9" fill="#e6c9a8"/>
      </g>
      <g class="head">
        <ellipse cx="100" cy="80" rx="34" ry="38" fill="#e6c9a8"/>
        <path d="M66 70 Q70 40 100 40 Q130 40 134 70 Q128 56 100 56 Q72 56 66 70 Z" fill="var(--ink)"/>
        <circle class="eye" cx="88" cy="82" r="2.5" fill="var(--ink)"/>
        <circle class="eye" cx="112" cy="82" r="2.5" fill="var(--ink)"/>
        <path d="M92 96 Q100 102 108 96" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" fill="none"/>
      </g>
    </svg>
  )}
</div>

<style>
  .character {
    width: var(--char-size);
    height: auto;
    display: inline-block;
    position: relative;
  }
  .character svg { width: 100%; height: auto; overflow: visible; }

  /* Image / video mode — steady, gentle float */
  .char-image-wrap {
    position: relative;
    width: 100%;
    animation: float 6s ease-in-out infinite;
  }
  .char-img,
  .char-video {
    width: 100%;
    height: auto;
    display: block;
  }
  .char-img.hover {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--dur-med) var(--ease-out);
  }
  .character.has-image:hover .char-img.hover {
    opacity: 1;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }

  /* SVG placeholder animations */
  .body, .head { transform-origin: 100px 130px; animation: sway 6s ease-in-out infinite; }
  .head { animation-duration: 5.4s; }
  .mood-wave .arm-right { transform-origin: 136px 128px; animation: wave 2.6s ease-in-out infinite; }
  .mood-idle .arm-right { transform-origin: 136px 128px; animation: sway 5s ease-in-out infinite; }
  .eye { animation: blink 4.3s infinite; transform-origin: center; }

  @keyframes sway {
    0%, 100% { transform: rotate(-1.2deg); }
    50%      { transform: rotate(1.2deg); }
  }
  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    15%      { transform: rotate(-18deg); }
    30%      { transform: rotate(12deg); }
    45%      { transform: rotate(-18deg); }
    60%      { transform: rotate(0deg); }
  }
  @keyframes blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95%           { transform: scaleY(0.1); }
  }
</style>

---
interface PoseSet {
  front: string;
  left?: string;
  right?: string;
  wave?: string;
  back?: string;
}
interface Props {
  size?: number;
  alt?: string;
  poses?: PoseSet;
  src?: string;
  srcHover?: string;
}
const { size = 220, alt = 'Portrait', poses, src, srcHover } = Astro.props;
const hasPoses = !!poses;
---
<div class="character" style={`--char-size:${size}px`}>
  {hasPoses ? (
    <div class="char-poses" data-poses={JSON.stringify(poses)}>
      {Object.entries(poses!).map(([key, url]) => (
        <img
          src={url}
          alt={key === 'front' ? alt : ''}
          class:list={["pose", `pose-${key}`, { active: key === 'front' }]}
          loading="lazy"
          draggable="false"
        />
      ))}
    </div>
  ) : src ? (
    <div class="char-single">
      <img src={src} alt={alt} class="pose active" loading="lazy" draggable="false" />
      {srcHover && (
        <img src={srcHover} alt="" class="pose hover-pose" loading="lazy" draggable="false" />
      )}
    </div>
  ) : (
    <svg viewBox="0 0 200 260" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={alt}>
      <ellipse cx="100" cy="248" rx="46" ry="6" fill="rgba(0,0,0,0.12)" />
      <g class="body">
        <path d="M60 120 Q100 100 140 120 L136 195 Q100 208 64 195 Z" fill="var(--accent)" />
      </g>
      <g class="head">
        <ellipse cx="100" cy="80" rx="34" ry="38" fill="#f2c8a0"/>
        <path d="M66 70 Q70 40 100 40 Q130 40 134 70 Q128 56 100 56 Q72 56 66 70 Z" fill="var(--ink)"/>
        <circle cx="88" cy="82" r="2.5" fill="var(--ink)"/>
        <circle cx="112" cy="82" r="2.5" fill="var(--ink)"/>
        <path d="M92 96 Q100 102 108 96" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" fill="none"/>
      </g>
    </svg>
  )}
</div>

<script>
  document.querySelectorAll<HTMLDivElement>('.char-poses').forEach((el) => {
    const poses = JSON.parse(el.dataset.poses || '{}');
    const imgs = el.querySelectorAll<HTMLImageElement>('.pose');
    let current = 'front';

    function show(name: string) {
      if (name === current) return;
      imgs.forEach((img) => {
        const key = img.classList[1]?.replace('pose-', '');
        if (key === name) {
          img.classList.add('active');
        } else {
          img.classList.remove('active');
        }
      });
      current = name;
    }

    el.addEventListener('mouseenter', () => {
      if (poses.wave) show('wave');
    });
    el.addEventListener('mouseleave', () => show('front'));

    document.addEventListener('mousemove', (e) => {
      if (el.matches(':hover')) return;
      const w = window.innerWidth;
      const x = e.clientX / w;
      if (x < 0.33 && poses.left) show('left');
      else if (x > 0.66 && poses.right) show('right');
      else show('front');
    });
  });
</script>

<style>
  .character {
    width: var(--char-size);
    display: inline-block;
    position: relative;
  }
  .character svg { width: 100%; height: auto; }

  .char-poses, .char-single {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }
  .pose {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.35s ease;
    mix-blend-mode: multiply;
  }
  .pose.active { opacity: 1; }

  .char-single:hover .hover-pose { opacity: 1; }
  .char-single:hover .active:not(.hover-pose) { opacity: 0; }

  .char-poses {
    animation: breathe 4s ease-in-out infinite;
  }
  @keyframes breathe {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
</style>

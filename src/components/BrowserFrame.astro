---
// A CSS-drawn browser window. Same three fill modes as PhoneFrame:
//   1. `src` prop → renders that image as the browser body.
//   2. Default slot → renders inside the body area.
//   3. Neither → generic placeholder web UI.
interface Props {
  src?: string;
  alt?: string;
  scheme?: 'warm' | 'cool' | 'ink';
  url?: string;
}
const { src, alt = '', scheme = 'warm', url } = Astro.props;
const hasSlot = Astro.slots.has('default');
---
<div class="browser">
  <div class="browser-chrome">
    <span class="dot dot-1" aria-hidden="true"></span>
    <span class="dot dot-2" aria-hidden="true"></span>
    <span class="dot dot-3" aria-hidden="true"></span>
    {url && <span class="url">{url}</span>}
  </div>
  <div class="browser-body">
    {src ? (
      <img src={src} alt={alt} class="browser-image" />
    ) : hasSlot ? (
      <slot />
    ) : (
      <div class={`bw-ui bw-${scheme}`}>
        <div class="bw-nav">
          <div class="bw-brand"></div>
          <div class="bw-links">
            <span></span><span></span><span></span><span></span>
          </div>
        </div>
        <div class="bw-hero">
          <div class="bw-copy">
            <div class="bw-h1"></div>
            <div class="bw-h2"></div>
            <div class="bw-p"></div>
            <div class="bw-p bw-p-short"></div>
            <span class="bw-cta"></span>
          </div>
          <div class="bw-media"></div>
        </div>
      </div>
    )}
  </div>
</div>

<style>
  .browser {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(0,0,0,0.10);
    display: flex; flex-direction: column;
  }
  .browser-chrome {
    height: 24px;
    background: #efeee9;
    display: flex; align-items: center; gap: 5px;
    padding: 0 10px;
    border-bottom: 1px solid var(--rule);
    flex-shrink: 0;
  }
  .dot { width: 9px; height: 9px; border-radius: 50%; }
  .dot-1 { background: #ec5f5b; }
  .dot-2 { background: #f5b74a; }
  .dot-3 { background: #62c454; }
  .url {
    margin-left: 12px;
    padding: 2px 8px;
    background: #fff;
    border: 1px solid #dedbd2;
    border-radius: 4px;
    font-family: var(--font-mono, monospace);
    font-size: 9px;
    color: #837c68;
  }
  .browser-body {
    flex: 1;
    background: #fff;
    overflow: hidden;
    position: relative;
  }
  .browser-image {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Placeholder web UI */
  .bw-ui {
    padding: 14px 18px;
    height: 100%;
    display: flex; flex-direction: column;
    color: #0f0f0e;
    background: #fafafa;
  }
  .bw-warm { background: #fbf9f4; }
  .bw-cool { background: #f4f7fb; }
  .bw-ink  { background: #16130f; color: #eee8dc; }

  .bw-nav {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 14px;
  }
  .bw-brand { width: 28px; height: 6px; background: currentColor; border-radius: 2px; }
  .bw-links { display: flex; gap: 8px; }
  .bw-links span {
    width: 18px; height: 5px;
    background: currentColor;
    opacity: 0.35;
    border-radius: 2px;
  }
  .bw-hero {
    display: flex; gap: 16px; align-items: center;
    flex: 1;
  }
  .bw-copy { flex: 1; display: flex; flex-direction: column; gap: 6px; }
  .bw-h1 { height: 10px; width: 90%; background: currentColor; border-radius: 3px; }
  .bw-h2 { height: 10px; width: 65%; background: currentColor; border-radius: 3px; }
  .bw-p  { height: 4px; width: 80%; background: currentColor; opacity: 0.4; border-radius: 2px; margin-top: 3px; }
  .bw-p-short { width: 60%; }
  .bw-cta {
    margin-top: 8px; height: 14px; width: 70px;
    background: var(--accent, #b8342a);
    border-radius: 3px;
  }
  .bw-media {
    width: 38%; aspect-ratio: 1;
    background: linear-gradient(135deg, #efe3d0, #d4a97f);
    border-radius: 6px;
  }
  .bw-cool .bw-media { background: linear-gradient(135deg, #c8d8f0, #7a9fd4); }
  .bw-ink  .bw-media { background: linear-gradient(135deg, #3a3a35, #1a1a17); }
</style>

---
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<section class="cs-section">
  <div class="cs-section-label">{label}</div>
  <div class="cs-section-content">
    <slot />
  </div>
</section>

<style>
  .cs-section {
    display: grid;
    grid-template-columns: clamp(120px, 15vw, 200px) 1fr;
    gap: clamp(2rem, 4vw, 5rem);
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--rule);
    align-items: start;
  }
  .cs-section-label {
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    padding-top: 0.35rem;
  }
  .cs-section-content {
    max-width: 820px;
  }
  .cs-section-content :global(p) {
    color: var(--ink-2);
    line-height: 1.7;
    text-align: justify;
    margin-block: 1rem;
    font-size: clamp(0.9rem, 1.1vw, 1rem);
  }
  .cs-section-content :global(p:first-child) {
    margin-top: 0;
  }
  .cs-section-content :global(p strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .cs-section-content :global(ul),
  .cs-section-content :global(ol) {
    padding-left: 1.25rem;
    color: var(--ink-2);
    line-height: 1.7;
    text-align: justify;
    font-size: clamp(0.9rem, 1.1vw, 1rem);
  }
  .cs-section-content :global(li) {
    margin-block: 0.5rem;
  }
  .cs-section-content :global(li strong) {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .cs-section {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>

---
// Studio hero: giant index number on the left, meta / name / description
// / arrow-links on the right. Deliberately quiet — the character does not
// live here; it belongs on the About page. The work grid below carries the
// visual weight of the page.
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="index-col">
      <span class="index-num">05<span class="index-total">/25</span></span>
    </div>

    <div class="meta-col">
      <div class="hero-label">Index of Work · 2020 → 2025</div>

      <div class="hero-name">
        Your Name — Product designer working across web and mobile interfaces.
      </div>

      <p class="hero-desc">
        Short introduction. Two sentences on what you do, who you tend to work
        with, and what makes the work distinctive. Replace with your own words.
      </p>

      <ul class="hero-links">
        <li><a href="#work"><span>Selected work</span></a></li>
        <li><a href="/ui-ux/about"><span>About the studio</span></a></li>
        <li><a href="mailto:inquire.raincityav@gmail.com"><span>Get in touch</span></a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 4rem 6rem;
    border-bottom: 1px solid var(--rule);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem 4rem;
    align-items: end;
  }
  .index-col {
    line-height: 0;
  }
  .index-num {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 96;
    font-weight: 300;
    font-size: var(--hero);
    line-height: 0.82;
    letter-spacing: -0.06em;
    color: var(--ink);
    display: block;
  }
  .index-total {
    color: var(--ink-4);
  }
  .meta-col {
    padding-bottom: 0.75rem;
  }
  .hero-label {
    font-size: var(--step--2);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 1.5rem;
  }
  .hero-name {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 24;
    font-weight: 500;
    font-size: clamp(1.6rem, 2.2vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
    text-wrap: balance;
    max-width: 22ch;
  }
  .hero-desc {
    font-size: var(--step-0);
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 38ch;
  }
  .hero-links {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 320px;
  }
  .hero-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    font-size: var(--step-0);
    transition: color var(--dur-fast), padding-left var(--dur-fast);
  }
  .hero-links a::after {
    content: "→";
    color: var(--ink-4);
    transition: color var(--dur-fast), transform var(--dur-fast);
  }
  .hero-links a:hover {
    color: var(--accent);
    padding-left: 0.25rem;
  }
  .hero-links a:hover::after {
    color: var(--accent);
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .hero { padding-block: 2.5rem 4rem; }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .index-num { font-size: clamp(5rem, 22vw, 9rem); }
  }
</style>

---
import Character from './Character.astro';
const base = import.meta.env.BASE_URL;
---
<section class="hero wrap">
  <div class="kicker">
    <span>Selected Work · 2020 → 2025</span>
    <span class="k-avail">
      <span class="k-dot" aria-hidden="true"></span>
      Available Q1 2026
    </span>
  </div>

  <div class="hero-grid">
    <div class="hero-character">
      <Character
        size={440}
        poses={{
          front: `${base}character/idle-front.png`,
          left:  `${base}character/three-quarter-left.png`,
          right: `${base}character/three-quarter-right.png`,
          wave:  `${base}character/waving.png`,
        }}
        alt="Portrait"
      />
    </div>

    <div class="hero-copy">
      <h1 class="statement">
        SJAI Studio designs interfaces for <em>web</em> and <em>mobile</em> products
        &mdash; built with the person on the other end in mind.
      </h1>

      <hr class="statement-rule" />

      <p class="statement-desc">
        Short introduction. One or two sentences on what the studio does, who it
        tends to work with, and where. Replace with your own words.
      </p>

      <ul class="hero-links">
        <li><a href="#work"><span>Selected work</span></a></li>
        <li><a href={`${base}about`}><span>About the studio</span></a></li>
        <li><a href="mailto:inquire.raincityav@gmail.com"><span>Get in touch</span></a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 3rem 5rem;
    border-bottom: 1px solid var(--rule);
  }

  .kicker {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    font-size: var(--step--2);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-bottom: 3rem;
  }
  .k-avail {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
  }
  .k-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px var(--accent-soft); }
    50%      { box-shadow: 0 0 0 8px rgba(184, 52, 42, 0.02); }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(300px, 1fr) 1.6fr;
    gap: 3rem 5rem;
    align-items: center;
  }
  .hero-character {
    display: flex;
    justify-content: flex-start;
    align-items: end;
    position: relative;
  }
  .hero-character::before {
    /* soft warm halo behind the figure so it doesn't float on the paper */
    content: "";
    position: absolute;
    left: -8%; right: 8%; bottom: 0;
    height: 55%;
    background: radial-gradient(ellipse at bottom, rgba(184, 52, 42, 0.06), transparent 65%);
    z-index: -1;
    pointer-events: none;
  }

  .hero-copy { max-width: 40rem; }
  .statement {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 96;
    font-weight: 300;
    font-size: clamp(2rem, 3.6vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
    max-width: 20ch;
    margin: 0;
  }
  .statement em {
    font-style: italic;
    font-variation-settings: "opsz" 96, "wght" 400;
    color: var(--accent);
  }
  .statement-rule {
    border: 0;
    height: 1px;
    background: var(--rule);
    margin: 2.5rem 0 1.75rem;
    max-width: 8rem;
  }
  .statement-desc {
    font-size: var(--step-0);
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 46ch;
    margin: 0;
  }
  .hero-links {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-direction: column;
    max-width: 320px;
  }
  .hero-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    font-size: var(--step-0);
    transition: color var(--dur-fast), padding-left var(--dur-fast);
  }
  .hero-links a::after {
    content: "→";
    color: var(--ink-4);
    transition: color var(--dur-fast), transform var(--dur-fast);
  }
  .hero-links a:first-child { border-top: 1px solid var(--rule); }
  .hero-links a:hover {
    color: var(--accent);
    padding-left: 0.25rem;
  }
  .hero-links a:hover::after {
    color: var(--accent);
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .hero { padding-block: 2rem 3.5rem; }
    .kicker { flex-direction: column; align-items: start; gap: 0.75rem; padding-bottom: 2rem; }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero-character { justify-content: center; }
  }
</style>

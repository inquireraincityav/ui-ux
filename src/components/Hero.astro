---
import Character from './Character.astro';

// When you have a 3D render of yourself, drop it in public/character/ and pass
// <Character src="/character/you.webp" srcHover="/character/you-wave.webp" />
// It'll swap in automatically. Until then this shows the SVG placeholder.
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <a class="status-pill" href="mailto:inquire.raincityav@gmail.com">
        <span class="dot"></span>
        Available for freelance &amp; contract
      </a>

      <h1>
        I fix the screens<br/>
        people <em>actually</em> get stuck on.
      </h1>

      <p class="lede">
        Five case studies. Every one starts with a before shot, an honest breakdown of
        what was failing, and the smallest change that fixed it.<br/>
        No mood boards. No fluff.
      </p>

      <div class="cta-row">
        <a href="#work" class="btn-primary">See the work</a>
        <a href="#process" class="btn-ghost">How I think →</a>
      </div>
    </div>

    <div class="hero-character" aria-hidden="true">
      <Character
        size={380}
        src={`${import.meta.env.BASE_URL}character/idle-front.png`}
        srcHover={`${import.meta.env.BASE_URL}character/waving.png`}
        alt="Illustrated portrait"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 3rem 5rem;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 3rem;
    align-items: center;
    min-height: min(72vh, 640px);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 77, 94, 0.10);
    color: var(--accent);
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: background var(--dur-fast);
  }
  .status-pill:hover { background: rgba(255, 77, 94, 0.18); }
  .status-pill .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(255, 77, 94, 0.18);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(255, 77, 94, 0.18); }
    50%      { box-shadow: 0 0 0 7px rgba(255, 77, 94, 0.05); }
  }

  h1 {
    margin-top: 1.5rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  h1 em {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    color: var(--ink-3);
    letter-spacing: -0.01em;
  }

  .lede {
    margin-top: 1.5rem;
    font-size: var(--step-0);
    color: var(--ink-2);
    max-width: 42ch;
    line-height: 1.55;
  }

  .cta-row {
    margin-top: 2rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: var(--ink);
    color: var(--paper);
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    transition: transform var(--dur-fast), background var(--dur-fast);
  }
  .btn-primary:hover { transform: translateY(-2px); background: var(--accent); }
  .btn-ghost {
    color: var(--ink);
    text-decoration: none;
    padding: 0.85rem 0.5rem;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast);
  }
  .btn-ghost:hover { border-bottom-color: var(--ink); }

  .hero-character {
    display: flex;
    justify-content: center;
    align-items: end;
    position: relative;
    height: 100%;
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .hero-character { order: -1; margin-bottom: 1rem; }
  }
</style>

---
// Studio index hero. Full-width statement of practice, no giant number
// gimmick, no character. Editorial in feel: kicker, oversized headline
// spanning the container, thin rule, description on the left with
// arrow-linked navigation on the right.
---
<section class="hero wrap">
  <div class="kicker">
    <span>Selected Work · 2020 → 2025</span>
    <span class="k-avail">
      <span class="k-dot" aria-hidden="true"></span>
      Available Q1 2026
    </span>
  </div>

  <h1 class="statement">
    SJAI Studio designs interfaces for <em>web</em> and <em>mobile</em> products
    &mdash; built with the person on the other end in mind.
  </h1>

  <hr class="statement-rule" />

  <div class="statement-foot">
    <p class="statement-desc">
      Short introduction. One or two sentences on what the studio does, who it
      tends to work with, and where. Replace with your own words.
    </p>

    <ul class="hero-links">
      <li><a href="#work"><span>Selected work</span></a></li>
      <li><a href="/ui-ux/about"><span>About the studio</span></a></li>
      <li><a href="mailto:inquire.raincityav@gmail.com"><span>Get in touch</span></a></li>
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: 3rem 5rem;
    border-bottom: 1px solid var(--rule);
  }
  .kicker {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    font-size: var(--step--2);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-bottom: 3rem;
  }
  .k-avail {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
  }
  .k-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px var(--accent-soft); }
    50%      { box-shadow: 0 0 0 8px rgba(184, 52, 42, 0.02); }
  }

  .statement {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 96;
    font-weight: 300;
    font-size: clamp(2.25rem, 5vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
    max-width: 22ch;
    margin: 0;
  }
  .statement em {
    font-style: italic;
    font-variation-settings: "opsz" 96, "wght" 400;
    color: var(--accent);
  }

  .statement-rule {
    border: 0;
    height: 1px;
    background: var(--rule);
    margin: 3rem 0 2rem;
  }

  .statement-foot {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem 4rem;
    align-items: start;
  }
  .statement-desc {
    font-size: var(--step-1);
    color: var(--ink-2);
    line-height: 1.55;
    max-width: 46ch;
    padding-top: 0.5rem;
  }
  .hero-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .hero-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    font-size: var(--step-0);
    transition: color var(--dur-fast), padding-left var(--dur-fast);
  }
  .hero-links a::after {
    content: "→";
    color: var(--ink-4);
    transition: color var(--dur-fast), transform var(--dur-fast);
  }
  .hero-links a:first-child { border-top: 1px solid var(--rule); }
  .hero-links a:hover {
    color: var(--accent);
    padding-left: 0.25rem;
  }
  .hero-links a:hover::after {
    color: var(--accent);
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .hero { padding-block: 2rem 3.5rem; }
    .kicker { flex-direction: column; align-items: start; gap: 0.75rem; padding-bottom: 2rem; }
    .statement-foot { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>

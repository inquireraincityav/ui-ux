---
// Hero: full-width editorial statement.
---
<section class="hero wrap">
  <div class="kicker">
    <span>Selected Work · 2020 → 2025</span>
    <span class="k-avail">
      <span class="k-dot" aria-hidden="true"></span>
      Available Q1 2026
    </span>
  </div>

  <h1 class="statement">
    SJAI Studio designs interfaces for <em>web</em> and <em>mobile</em> products
    &mdash; built with the person on the other end in mind.
  </h1>

</section>

<style>
  .hero {
    padding-block: 4rem 8rem;
    border-bottom: 1px solid var(--rule);
  }
  .kicker {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    font-size: var(--step--2);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-bottom: 3rem;
  }
  .k-avail {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
  }
  .k-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px var(--accent-soft); }
    50%      { box-shadow: 0 0 0 8px rgba(184, 52, 42, 0.02); }
  }

  .statement {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 96;
    font-weight: 300;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
    max-width: 22ch;
    margin: 0;
  }
  .statement em {
    font-style: italic;
    font-variation-settings: "opsz" 96, "wght" 400;
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .hero { padding-block: 2.5rem 5rem; }
    .kicker { flex-direction: column; align-items: start; gap: 0.75rem; padding-bottom: 2rem; }
  }
</style>

---
const base = import.meta.env.BASE_URL;
---
<section class="hero wrap">
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  >
    <source src={`${base}hero-bg.mp4`} type="video/mp4" />
  </video>
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-foot">
    <p class="hero-name">Jaival Shah</p>
    <p class="hero-role">UI/UX Designer · Vancouver, BC</p>
    <div class="hero-actions">
      <a href="#work" class="hero-cta">Explore My Work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    height: calc(100svh - 4.5rem);
    min-height: 480px;
    max-height: 1100px;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(2rem, 5vh, 4rem);
    border-bottom: 1px solid var(--rule);
    position: relative;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(245, 244, 240, 0.82);
    z-index: 1;
  }

  .hero-foot {
    max-width: 42rem;
    width: 100%;
    position: relative;
    z-index: 2;
  }
  .hero-name {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 48;
    font-weight: 500;
    font-size: clamp(1.5rem, 2.5vw, 2.4rem);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    text-align: left;
  }
  .hero-role {
    font-size: clamp(0.8rem, 1.1vw, 0.94rem);
    color: var(--ink-3);
    font-weight: 400;
    margin-top: 0.35rem;
    text-align: left;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 2rem;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.6rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: clamp(0.8rem, 1vw, 0.94rem);
    font-weight: 500;
    text-decoration: none;
    border-radius: 4px;
    letter-spacing: 0.02em;
    transition: background var(--dur-fast);
  }
  .hero-cta:hover {
    background: var(--accent);
    color: var(--paper);
  }
  /* Tablet */
  @media (max-width: 1024px) {
    .hero { min-height: 70vh; }
    .hero-foot { max-width: 36rem; }
  }

  /* Mobile */
  @media (max-width: 640px) {
    .hero {
      height: auto;
      min-height: calc(80svh - 4rem);
      padding-bottom: 1.5rem;
    }
    .hero-foot { max-width: 100%; }
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>

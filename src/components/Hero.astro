---
import Character from './Character.astro';
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Portfolio · <span>UI/UX Designer</span></p>
      <h1>
        I fix the screens<br/>
        people <em>actually</em> get stuck on.
      </h1>
      <p class="lede">
        Five case studies. Every one starts with a before shot, an honest breakdown of
        what was failing, and the smallest change that fixed it. No mood boards. No fluff.
      </p>
      <div class="cta-row">
        <a href="#work" class="btn-primary">See the work</a>
        <a href="#process" class="btn-ghost">How I think →</a>
      </div>
    </div>
    <div class="hero-character" aria-hidden="true">
      <Character size={260} mood="wave" />
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>Interaction design</span><span>·</span>
      <span>Usability testing</span><span>·</span>
      <span>Design systems</span><span>·</span>
      <span>Prototyping</span><span>·</span>
      <span>Research synthesis</span><span>·</span>
      <span>Accessibility</span><span>·</span>
      <span>Interaction design</span><span>·</span>
      <span>Usability testing</span><span>·</span>
      <span>Design systems</span><span>·</span>
      <span>Prototyping</span><span>·</span>
      <span>Research synthesis</span><span>·</span>
      <span>Accessibility</span><span>·</span>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: 4rem 3rem; overflow: hidden; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-copy .eyebrow span { color: var(--ink-2); text-transform: none; letter-spacing: 0; font-weight: 400; }
  h1 { margin-top: 1.25rem; }
  h1 em { font-style: italic; color: var(--accent); }
  .lede {
    margin-top: 1.75rem;
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 34ch;
  }
  .cta-row { margin-top: 2rem; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .btn-primary {
    background: var(--ink);
    color: var(--paper);
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    transition: transform var(--dur-fast), background var(--dur-fast);
  }
  .btn-primary:hover { transform: translateY(-2px); background: var(--accent); }
  .btn-ghost {
    color: var(--ink);
    text-decoration: none;
    padding: 0.85rem 0.5rem;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast);
  }
  .btn-ghost:hover { border-bottom-color: var(--ink); }

  .hero-character {
    display: flex;
    justify-content: center;
    align-items: end;
    position: relative;
  }
  .hero-character::before {
    content: '';
    position: absolute;
    inset: auto 10% 0 10%;
    height: 70%;
    background: radial-gradient(ellipse at bottom, rgba(224,90,43,0.12), transparent 70%);
    z-index: -1;
    border-radius: 50%;
  }

  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; text-align: left; }
    .hero-character { order: -1; margin-bottom: 1rem; }
  }

  .marquee {
    margin-top: 4rem;
    padding-block: 1rem;
    border-block: 1px solid var(--rule);
    overflow: hidden;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--ink-3);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: inline-flex;
    gap: 2rem;
    white-space: nowrap;
    animation: scroll 40s linear infinite;
  }
  .marquee-track span:nth-child(even) { color: var(--accent); }
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>

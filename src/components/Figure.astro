---
// A simple image + caption block for case-study bodies. Use it in MDX like:
//   <Figure src="/ui-ux/screens/foo.png" caption="What this shows." />
// Add `wide` to break out beyond the body column width.
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  wide?: boolean;
  canvas?: 'light' | 'warm' | 'dark' | 'none';
}
const {
  src,
  alt = '',
  caption,
  wide = false,
  canvas = 'light',
} = Astro.props;
---
<figure class:list={["cs-fig", { 'is-wide': wide }, `canvas-${canvas}`]}>
  <div class="cs-fig-frame">
    <img src={src} alt={alt} loading="lazy" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .cs-fig {
    margin-block: 2.5rem;
  }
  .cs-fig.is-wide {
    margin-inline: calc(-1 * var(--gutter));
  }
  @media (min-width: 900px) {
    .cs-fig.is-wide { margin-inline: -6rem; }
  }
  .cs-fig-frame {
    border-radius: 4px;
    overflow: hidden;
    padding: clamp(1rem, 3%, 2rem);
  }
  .canvas-light .cs-fig-frame { background: var(--canvas); border: 1px solid var(--rule); }
  .canvas-warm  .cs-fig-frame { background: var(--canvas-warm); border: 1px solid #d9c6a8; }
  .canvas-dark  .cs-fig-frame { background: var(--canvas-dark); border: 1px solid var(--canvas-dark); }
  .canvas-none  .cs-fig-frame { padding: 0; border: 0; background: transparent; }
  .cs-fig-frame img { width: 100%; height: auto; display: block; border-radius: 2px; }

  figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-3);
    line-height: 1.5;
    font-style: italic;
    text-align: center;
    max-width: 60ch;
    margin-inline: auto;
  }
</style>

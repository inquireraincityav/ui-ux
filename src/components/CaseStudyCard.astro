---
interface Props {
  title: string;
  subtitle?: string;
  role: string;
  year: string;
  summary: string;
  href: string;
  index: number;
  type?: 'web' | 'mobile' | 'both';
  canvas?: 'light' | 'warm' | 'dark';
  coverScheme?: 'warm' | 'cool' | 'ink';
  cover?: string;
  wip?: boolean;
}
const {
  title, subtitle, role, year, summary, href, index,
  type = 'web', canvas = 'light', coverScheme = 'warm', cover, wip = false,
} = Astro.props;

const typeLabel = type === 'both' ? 'Web + Mobile' : type === 'mobile' ? 'Mobile' : 'Web';
---
<a class="tile" href={href}>
  {wip && <span class="wip-badge">Work in Progress</span>}
  <div class:list={["tile-media", type === 'mobile' && "tile-media--phone"]}>
    {cover && type === 'mobile' ? (
      <div class="card-phone">
        <div class="card-phone-body">
          <div class="card-phone-screen">
            <img src={cover} alt={`${title} screenshot`} loading="lazy" />
          </div>
          <img class="card-phone-frame" src="/iphone-frame.png" alt="" aria-hidden="true" loading="lazy" />
        </div>
      </div>
    ) : cover ? (
      <img src={cover} alt={`${title} screenshot`} loading="lazy" />
    ) : null}
  </div>
  <div class="tile-overlay">
    <div class="tile-overlay-inner">
      <span class="tile-tag">{typeLabel} · {year}</span>
      <h3 class="tile-title">{title}</h3>
      {subtitle && <p class="tile-role">{subtitle}</p>}
      <p class="tile-desc">{summary}</p>
    </div>
  </div>
</a>

<style>
  .tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    background: var(--canvas);
    height: 100%;
  }

  .tile-media {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .tile-media img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .tile:hover .tile-media img {
    transform: scale(0.93);
  }

  .card-phone {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .tile:hover .card-phone {
    transform: scale(0.93);
  }
  .card-phone-body {
    position: relative;
    aspect-ratio: 501 / 1030;
    height: 100%;
    max-height: calc(100% - 1rem);
  }
  .card-phone-screen {
    position: absolute;
    top: 1.6%;
    left: 1.6%;
    width: 96.8%;
    height: 96.6%;
    border-radius: 9.2%;
    overflow: hidden;
    background: #fff;
  }
  .card-phone-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    max-width: none;
    max-height: none;
  }
  .card-phone-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 1;
    max-width: none;
    max-height: none;
  }

  /* ── Frosted glass overlay ── */
  .tile-overlay {
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    background: rgba(236, 235, 229, 0.65);
    opacity: 0;
    transition: opacity 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 2;
    border-radius: 10px;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    overflow: hidden;
  }

  .tile:hover .tile-overlay {
    opacity: 1;
  }

  .tile-overlay-inner {
    transform: translateY(16px);
    opacity: 0;
    transition:
      transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      opacity 0.4s ease;
    transition-delay: 0.06s;
  }

  .tile:hover .tile-overlay-inner {
    transform: translateY(0);
    opacity: 1;
  }

  .wip-badge {
    position: absolute;
    top: clamp(0.6rem, 1.2vw, 1rem);
    right: clamp(0.6rem, 1.2vw, 1rem);
    z-index: 3;
    padding: 0.3rem 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
    background: rgba(245, 244, 240, 0.85);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .tile-tag {
    display: block;
    font-size: clamp(0.65rem, 0.75vw, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    margin-bottom: 0.5rem;
  }

  .tile-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 48;
    font-weight: 600;
    font-size: clamp(1.25rem, 2vw, 2rem);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .tile-role {
    font-size: clamp(0.8rem, 0.95vw, 0.95rem);
    color: var(--ink-2);
    margin-top: 0.3rem;
    font-weight: 500;
  }

  .tile-desc {
    font-size: clamp(0.75rem, 0.85vw, 0.85rem);
    color: var(--ink-3);
    margin-top: 0.75rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Mobile: compact, light, always-visible titles ── */
  @media (max-width: 768px) {
    .tile {
      background: transparent;
      display: flex;
      flex-direction: column;
      height: auto;
      border-radius: 0;
    }

    .tile-media {
      height: auto;
      padding: 0;
      border-radius: 8px;
      overflow: hidden;
    }

    .tile-media img {
      width: 100%;
      max-height: 180px;
      object-fit: contain;
    }

    .tile-media--phone {
      padding: 1rem;
      background: var(--canvas);
      border-radius: 8px;
    }

    .card-phone-body {
      height: 220px;
    }

    .tile:hover .tile-media img,
    .tile:hover .card-phone {
      transform: none;
    }

    .tile-overlay {
      position: static;
      opacity: 1;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: transparent;
      padding: 0.6rem 0 0;
      border-radius: 0;
    }

    .tile-overlay-inner {
      transform: none;
      opacity: 1;
      transition: none;
    }

    .tile-tag { color: var(--ink-3); }
    .tile-title { color: var(--ink); font-size: 1.1rem; }
    .tile-role { color: var(--ink-2); }
    .tile-desc { display: none; }
  }
</style>

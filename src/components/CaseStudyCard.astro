---
interface Props {
  title: string;
  subtitle?: string;
  role: string;
  year: string;
  summary: string;
  href: string;
  index: number;
  type?: 'web' | 'mobile' | 'both';
  canvas?: 'light' | 'warm' | 'dark';
  coverScheme?: 'warm' | 'cool' | 'ink';
  cover?: string;
}
const {
  title, subtitle, role, year, summary, href, index,
  type = 'web', canvas = 'light', coverScheme = 'warm', cover,
} = Astro.props;

const typeLabel = type === 'both' ? 'Web + Mobile' : type === 'mobile' ? 'Mobile' : 'Web';
---
<a class="tile" href={href}>
  <div class:list={["tile-canvas", `canvas-${canvas}`]}>
    {(type === 'web' || type === 'both') && (
      <div class="macbook">
        <div class="macbook-lid">
          <div class="macbook-bezel">
            <span class="macbook-camera" />
            <div class="macbook-screen">
              {cover ? (
                <img src={cover} alt={`${title} screenshot`} loading="lazy" />
              ) : (
                <div class:list={["macbook-placeholder", `scheme-${coverScheme}`]} />
              )}
            </div>
          </div>
        </div>
        <div class="macbook-hinge" />
        <div class="macbook-base">
          <div class="macbook-keyboard">
            <div class="kb-row kb-row-fn" />
            <div class="kb-row" />
            <div class="kb-row" />
            <div class="kb-row" />
            <div class="kb-row kb-row-space" />
          </div>
          <div class="macbook-trackpad" />
        </div>
      </div>
    )}
    {type === 'mobile' && (
      <div class="iphone">
        <div class="iphone-body">
          <div class="iphone-notch" />
          <div class="iphone-screen">
            {cover ? (
              <img src={cover} alt={`${title} screenshot`} loading="lazy" />
            ) : (
              <div class:list={["iphone-placeholder", `scheme-${coverScheme}`]} />
            )}
          </div>
          <div class="iphone-home" />
        </div>
      </div>
    )}
  </div>
  <div class="tile-info">
    <div class="tile-meta">
      <span class="tile-type">{typeLabel}</span>
      <span class="tile-year">{year}</span>
    </div>
    <h3 class="tile-title">{title}</h3>
    {subtitle && <p class="tile-sub">{subtitle}</p>}
  </div>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 6px;
    overflow: hidden;
    transition: transform var(--dur-med) var(--ease-out);
  }
  .tile:hover { transform: translateY(-4px); }
  .tile:hover .tile-title { color: var(--accent); }

  .tile-canvas {
    aspect-ratio: 4/3;
    display: grid;
    place-items: center;
    padding: 2.5rem 2rem 1.5rem;
    border-radius: 6px;
    overflow: hidden;
  }
  .canvas-light { background: var(--canvas); border: 1px solid var(--rule); }
  .canvas-warm  { background: var(--canvas-warm); border: 1px solid #d9c6a8; }
  .canvas-dark  { background: var(--canvas-dark); border: 1px solid var(--canvas-dark); }

  /* ── MacBook Frame ── */
  .macbook {
    width: 92%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .macbook-lid {
    width: 100%;
    background: #1d1d1f;
    border-radius: 8px 8px 0 0;
    padding: 8px 8px 4px;
  }

  .macbook-bezel {
    position: relative;
  }

  .macbook-camera {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #2a2a2c;
    margin: 0 auto 4px;
  }

  .macbook-screen {
    aspect-ratio: 16/10;
    overflow: hidden;
    border-radius: 2px;
    background: var(--canvas);
  }
  .macbook-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .macbook-hinge {
    width: 104%;
    height: 4px;
    background: linear-gradient(to bottom, #b8b8b8, #a0a0a0);
    border-radius: 0 0 1px 1px;
  }

  .macbook-base {
    width: 110%;
    background: linear-gradient(180deg, #c8c8c8 0%, #b0b0b0 40%, #a4a4a4 100%);
    border-radius: 0 0 6px 6px / 0 0 6px 6px;
    padding: 6px 10% 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    position: relative;
  }
  .macbook-base::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 18%;
    height: 2px;
    background: #9a9a9a;
    border-radius: 0 0 3px 3px;
  }

  .macbook-keyboard {
    width: 92%;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .kb-row {
    height: 4px;
    background: linear-gradient(to right,
      transparent 0%, #8a8a8a 2%, #8a8a8a 98%, transparent 100%
    );
    border-radius: 1px;
    opacity: 0.5;
  }
  .kb-row-fn {
    height: 3px;
  }
  .kb-row-space {
    width: 60%;
    margin-inline: auto;
  }

  .macbook-trackpad {
    width: 38%;
    height: 10px;
    background: linear-gradient(180deg, #bbb 0%, #aaa 100%);
    border: 1px solid #999;
    border-radius: 3px;
    margin-top: 2px;
  }

  /* ── iPhone Frame ── */
  .iphone { width: 42%; max-width: 170px; }
  .iphone-body {
    background: #1d1d1f;
    border-radius: 22px;
    padding: 7px;
    position: relative;
    border: 1px solid #333;
  }
  .iphone-notch {
    position: absolute;
    top: 9px;
    left: 50%;
    transform: translateX(-50%);
    width: 30%;
    height: 14px;
    background: #1d1d1f;
    border-radius: 0 0 10px 10px;
    z-index: 2;
  }
  .iphone-screen {
    aspect-ratio: 9/19.5;
    overflow: hidden;
    border-radius: 16px;
    background: var(--canvas);
    position: relative;
  }
  .iphone-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .iphone-home {
    width: 32%;
    height: 3px;
    background: #555;
    border-radius: 3px;
    margin: 5px auto 3px;
  }

  /* Placeholders */
  .macbook-placeholder, .iphone-placeholder { width: 100%; height: 100%; }
  .scheme-warm { background: linear-gradient(135deg, #efe3d0 0%, #d9c6a8 100%); }
  .scheme-cool { background: linear-gradient(135deg, #dce5ed 0%, #a8bdd5 100%); }
  .scheme-ink  { background: linear-gradient(135deg, #2a2a28 0%, #1a1a18 100%); }

  .tile-info { padding: 1.1rem 0.25rem; }
  .tile-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: var(--step--2);
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .tile-type {
    background: var(--paper-2);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    font-weight: 500;
  }
  .tile-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--step-2);
    margin-top: 0.5rem;
    transition: color var(--dur-fast);
  }
  .tile:hover .tile-title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }
  .tile-sub {
    color: var(--ink-3);
    font-size: var(--step--1);
    margin-top: 0.25rem;
    text-align: left;
  }
</style>

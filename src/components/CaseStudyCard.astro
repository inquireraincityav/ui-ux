---
interface Props {
  title: string;
  subtitle?: string;
  role: string;
  year: string;
  summary: string;
  href: string;
  index: number;
  type?: 'web' | 'mobile' | 'both';
  canvas?: 'light' | 'warm' | 'dark';
  coverScheme?: 'warm' | 'cool' | 'ink';
  cover?: string;
}
const {
  title, subtitle, role, year, summary, href, index,
  type = 'web', canvas = 'light', coverScheme = 'warm', cover,
} = Astro.props;

const typeLabel = type === 'both' ? 'Web + Mobile' : type === 'mobile' ? 'Mobile' : 'Web';
---
<a class="tile" href={href}>
  <div class="tile-media">
    {cover && <img src={cover} alt={`${title} screenshot`} loading="lazy" />}
  </div>
  <div class="tile-overlay">
    <div class="tile-overlay-inner">
      <span class="tile-tag">{typeLabel} · {year}</span>
      <h3 class="tile-title">{title}</h3>
      {subtitle && <p class="tile-role">{subtitle}</p>}
      <p class="tile-desc">{summary}</p>
    </div>
  </div>
</a>

<style>
  .tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    background: var(--canvas-dark);
    height: 100%;
  }

  .tile-media {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .tile-media img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .tile:hover .tile-media img {
    transform: scale(0.93);
  }

  /* ── Frosted glass overlay ── */
  .tile-overlay {
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    background: rgba(20, 20, 15, 0.55);
    opacity: 0;
    transition: opacity 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 2;
    border-radius: 10px;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    overflow: hidden;
  }

  .tile:hover .tile-overlay {
    opacity: 1;
  }

  .tile-overlay-inner {
    transform: translateY(16px);
    opacity: 0;
    transition:
      transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      opacity 0.4s ease;
    transition-delay: 0.06s;
  }

  .tile:hover .tile-overlay-inner {
    transform: translateY(0);
    opacity: 1;
  }

  .tile-tag {
    display: block;
    font-size: clamp(0.65rem, 0.75vw, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(245, 244, 240, 0.5);
    margin-bottom: 0.5rem;
  }

  .tile-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 48;
    font-weight: 600;
    font-size: clamp(1.25rem, 2vw, 2rem);
    letter-spacing: -0.02em;
    color: var(--paper);
  }

  .tile-role {
    font-size: clamp(0.8rem, 0.95vw, 0.95rem);
    color: rgba(245, 244, 240, 0.7);
    margin-top: 0.3rem;
    font-weight: 500;
  }

  .tile-desc {
    font-size: clamp(0.75rem, 0.85vw, 0.85rem);
    color: rgba(245, 244, 240, 0.55);
    margin-top: 0.75rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

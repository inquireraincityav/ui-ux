---
interface Props {
  title: string;
  role: string;
  year: string;
  summary: string;
  cover?: string;
  href: string;
  accent?: string;
  index: number;
}
const { title, role, year, summary, cover, href, accent = 'var(--accent)', index } = Astro.props;
---
<a class="cs-card" href={href} style={`--card-accent:${accent}`}>
  <div class="cs-cover">
    {cover
      ? <img src={cover} alt="" loading="lazy" />
      : (
        <div class="cs-cover-placeholder" aria-hidden="true">
          <span class="cs-num">{String(index).padStart(2, '0')}</span>
        </div>
      )}
    <div class="cs-arrow" aria-hidden="true">→</div>
  </div>

  <div class="cs-meta">
    <div class="cs-line">
      <span class="cs-index">{String(index).padStart(2, '0')}</span>
      <span class="cs-role">{role}</span>
      <span class="cs-year">{year}</span>
    </div>
    <h3 class="cs-title">{title}</h3>
    <p class="cs-summary">{summary}</p>
  </div>
</a>

<style>
  .cs-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    text-decoration: none;
    color: inherit;
    padding-block: 2rem;
    border-top: 1px solid var(--rule);
    transition: background var(--dur-med) var(--ease-out);
    position: relative;
    isolation: isolate;
  }
  .cs-card:hover { background: var(--paper-2); }
  .cs-card:hover .cs-title { color: var(--card-accent); }
  .cs-card:hover .cs-arrow { transform: translate(6px, -6px); opacity: 1; }
  .cs-card:hover .cs-cover img,
  .cs-card:hover .cs-cover-placeholder { transform: scale(1.03); }

  .cs-cover {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    border-radius: 6px;
    background: var(--paper-2);
    border: 1px solid var(--rule);
  }
  .cs-cover img, .cs-cover-placeholder {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .cs-cover-placeholder {
    display: grid; place-items: center;
    background:
      repeating-linear-gradient(-45deg, transparent 0 12px, var(--rule) 12px 13px),
      var(--paper-2);
  }
  .cs-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(3rem, 8vw, 5rem);
    color: var(--card-accent);
    opacity: 0.6;
  }
  .cs-arrow {
    position: absolute; top: 1rem; right: 1rem;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--ink); color: var(--paper);
    display: grid; place-items: center;
    font-size: 1.2rem;
    opacity: 0.85;
    transition: transform var(--dur-med) var(--ease-out), opacity var(--dur-med) var(--ease-out);
  }
  .cs-line {
    display: flex; gap: 1rem; align-items: center;
    font-size: var(--step--1); color: var(--ink-3);
    letter-spacing: 0.02em;
  }
  .cs-index { color: var(--card-accent); font-weight: 600; }
  .cs-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    margin-top: 0.35rem;
    transition: color var(--dur-med) var(--ease-out);
  }
  .cs-summary { color: var(--ink-2); margin-top: 0.5rem; max-width: 60ch; }

  @media (min-width: 820px) {
    .cs-card {
      grid-template-columns: 1.2fr 1fr;
      gap: 2.5rem;
      align-items: center;
    }
  }
</style>

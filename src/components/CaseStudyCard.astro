---
interface Props {
  title: string;
  subtitle?: string;
  role: string;
  year: string;
  summary: string;
  href: string;
  index: number;
  type?: 'web' | 'mobile' | 'both';
  canvas?: 'light' | 'warm' | 'dark';
  coverScheme?: 'warm' | 'cool' | 'ink';
  cover?: string;
}
const {
  title, subtitle, role, year, summary, href, index,
  type = 'web', canvas = 'light', coverScheme = 'warm', cover,
} = Astro.props;

const typeLabel = type === 'both' ? 'Web + Mobile' : type === 'mobile' ? 'Mobile' : 'Web';
---
<a class="tile" href={href}>
  <div class:list={["tile-canvas", `canvas-${canvas}`]}>
    {(type === 'web' || type === 'both') && (
      <div class="macbook">
        <div class="macbook-screen">
          <div class="macbook-viewport">
            {cover ? (
              <img src={cover} alt={`${title} screenshot`} loading="lazy" />
            ) : (
              <div class:list={["macbook-placeholder", `scheme-${coverScheme}`]} />
            )}
          </div>
        </div>
        <div class="macbook-base">
          <div class="macbook-notch" />
        </div>
      </div>
    )}
    {type === 'mobile' && (
      <div class="iphone">
        <div class="iphone-body">
          <div class="iphone-notch" />
          <div class="iphone-screen">
            {cover ? (
              <img src={cover} alt={`${title} screenshot`} loading="lazy" />
            ) : (
              <div class:list={["iphone-placeholder", `scheme-${coverScheme}`]} />
            )}
          </div>
          <div class="iphone-home" />
        </div>
      </div>
    )}
  </div>
  <div class="tile-info">
    <div class="tile-meta">
      <span class="tile-type">{typeLabel}</span>
      <span class="tile-year">{year}</span>
    </div>
    <h3 class="tile-title">{title}</h3>
    {subtitle && <p class="tile-sub">{subtitle}</p>}
  </div>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 4px;
    overflow: hidden;
    transition: transform var(--dur-med) var(--ease-out);
  }
  .tile:hover { transform: translateY(-4px); }
  .tile:hover .tile-title { color: var(--accent); }

  .tile-canvas {
    aspect-ratio: 4/3;
    display: grid;
    place-items: center;
    padding: 2rem;
    border-radius: 4px;
    overflow: hidden;
  }
  .canvas-light { background: var(--canvas); border: 1px solid var(--rule); }
  .canvas-warm  { background: var(--canvas-warm); border: 1px solid #d9c6a8; }
  .canvas-dark  { background: var(--canvas-dark); border: 1px solid var(--canvas-dark); }

  /* MacBook frame */
  .macbook { width: 90%; max-width: 360px; }
  .macbook-screen {
    background: #1d1d1f;
    border-radius: 6px 6px 0 0;
    padding: 6px 6px 0;
    position: relative;
  }
  .macbook-screen::before {
    content: '';
    position: absolute;
    top: 3px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #2a2a2c;
  }
  .macbook-viewport {
    aspect-ratio: 16/10;
    overflow: hidden;
    border-radius: 2px;
    background: var(--canvas);
  }
  .macbook-viewport img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .macbook-base {
    background: linear-gradient(to bottom, #c4c4c4, #a8a8a8);
    height: 8px;
    border-radius: 0 0 2px 2px;
    position: relative;
  }
  .macbook-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 22%;
    height: 3px;
    background: #b8b8b8;
    border-radius: 0 0 4px 4px;
  }

  /* iPhone frame */
  .iphone { width: 45%; max-width: 180px; }
  .iphone-body {
    background: #1d1d1f;
    border-radius: 20px;
    padding: 6px;
    position: relative;
  }
  .iphone-notch {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 28%;
    height: 12px;
    background: #1d1d1f;
    border-radius: 0 0 8px 8px;
    z-index: 2;
  }
  .iphone-screen {
    aspect-ratio: 9/19.5;
    overflow: hidden;
    border-radius: 16px;
    background: var(--canvas);
    position: relative;
  }
  .iphone-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .iphone-home {
    width: 32%;
    height: 3px;
    background: #555;
    border-radius: 3px;
    margin: 4px auto 2px;
  }

  /* Placeholders */
  .macbook-placeholder, .iphone-placeholder { width: 100%; height: 100%; }
  .scheme-warm { background: linear-gradient(135deg, #efe3d0 0%, #d9c6a8 100%); }
  .scheme-cool { background: linear-gradient(135deg, #dce5ed 0%, #a8bdd5 100%); }
  .scheme-ink  { background: linear-gradient(135deg, #2a2a28 0%, #1a1a18 100%); }

  .tile-info { padding: 1rem 0.25rem; }
  .tile-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: var(--step--2);
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .tile-type {
    background: var(--paper-2);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    font-weight: 500;
  }
  .tile-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--step-2);
    margin-top: 0.5rem;
    transition: color var(--dur-fast);
  }
  .tile:hover .tile-title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }
  .tile-sub {
    color: var(--ink-3);
    font-size: var(--step--1);
    margin-top: 0.25rem;
    text-align: left;
  }
</style>

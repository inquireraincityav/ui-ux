---
import PhoneFrame from './PhoneFrame.astro';
import BrowserFrame from './BrowserFrame.astro';

interface Props {
  title: string;
  subtitle?: string;
  role: string;
  year: string;
  summary: string;
  href: string;
  index: number;
  type?: 'web' | 'mobile' | 'both';
  canvas?: 'light' | 'warm' | 'dark';
  coverScheme?: 'warm' | 'cool' | 'ink';
  cover?: string;
}
const {
  title, subtitle, role, year, summary, href, index,
  type = 'web', canvas = 'light', coverScheme = 'warm', cover,
} = Astro.props;
---
<a class="tile" href={href}>
  <div class:list={["tile-canvas", `canvas-${canvas}`]}>
    {type === 'mobile' && <PhoneFrame scheme={coverScheme} />}
    {type === 'web' && <BrowserFrame scheme={coverScheme} />}
    {type === 'both' && (
      <div class="tile-both">
        <BrowserFrame scheme={coverScheme} />
        <PhoneFrame scheme={coverScheme} scale={0.4} />
      </div>
    )}
  </div>
  <div class="tile-info">
    <div class="tile-meta">
      <span class="tile-num">{String(index).padStart(2, '0')}</span>
      <span class="tile-role">{role}</span>
      <span class="tile-year">{year}</span>
    </div>
    <h3 class="tile-title">{title}</h3>
    {subtitle && <p class="tile-sub">{subtitle}</p>}
  </div>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 4px;
    overflow: hidden;
    transition: transform var(--dur-med) var(--ease-out);
  }
  .tile:hover { transform: translateY(-4px); }
  .tile:hover .tile-title { color: var(--accent); }

  .tile-canvas {
    aspect-ratio: 4/3;
    display: grid;
    place-items: center;
    padding: 2rem;
    border-radius: 4px;
    overflow: hidden;
  }
  .canvas-light { background: var(--canvas); border: 1px solid var(--rule); }
  .canvas-warm  { background: var(--canvas-warm); border: 1px solid #d9c6a8; }
  .canvas-dark  { background: var(--canvas-dark); border: 1px solid var(--canvas-dark); }

  .tile-both {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 1rem;
    align-items: center;
    width: 100%;
    height: 100%;
  }

  .tile-info { padding: 1rem 0.25rem; }
  .tile-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .tile-num { color: var(--accent); font-weight: 600; }
  .tile-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--step-2);
    margin-top: 0.4rem;
    transition: color var(--dur-fast);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }
  .tile:hover .tile-title {
    text-decoration-color: var(--accent);
  }
  .tile-sub {
    color: var(--ink-3);
    font-size: var(--step--1);
    margin-top: 0.25rem;
  }
</style>

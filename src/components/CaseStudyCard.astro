---
interface Props {
  title: string;
  subtitle?: string;
  role: string;
  year: string;
  summary: string;
  href: string;
  index: number;
  type?: 'web' | 'mobile' | 'both';
  canvas?: 'light' | 'warm' | 'dark';
  coverScheme?: 'warm' | 'cool' | 'ink';
  cover?: string;
}
const {
  title, subtitle, role, year, summary, href, index,
  type = 'web', canvas = 'light', coverScheme = 'warm', cover,
} = Astro.props;

const typeLabel = type === 'both' ? 'Web + Mobile' : type === 'mobile' ? 'Mobile' : 'Web';
---
<a class="tile" href={href}>
  <div class:list={["tile-canvas", `canvas-${canvas}`]}>
    {(type === 'web' || type === 'both') && (
      <div class="macbook">
        <div class="macbook-lid">
          <div class="macbook-bezel">
            <span class="macbook-camera" />
            <div class="macbook-screen">
              {cover ? (
                <img src={cover} alt={`${title} screenshot`} loading="lazy" />
              ) : (
                <div class:list={["macbook-placeholder", `scheme-${coverScheme}`]} />
              )}
            </div>
          </div>
        </div>
        <div class="macbook-hinge" />
        <div class="macbook-base">
          <div class="macbook-keyboard">
            <div class="kb-row kb-row-fn" />
            <div class="kb-row" />
            <div class="kb-row" />
            <div class="kb-row" />
            <div class="kb-row kb-row-space" />
          </div>
          <div class="macbook-trackpad" />
        </div>
      </div>
    )}
    {type === 'mobile' && (
      <div class="iphone">
        <div class="iphone-body">
          <div class="iphone-island" />
          <div class="iphone-screen">
            {cover ? (
              <img src={cover} alt={`${title} screenshot`} loading="lazy" />
            ) : (
              <div class:list={["iphone-placeholder", `scheme-${coverScheme}`]} />
            )}
          </div>
          <div class="iphone-home" />
        </div>
      </div>
    )}
  </div>
  <div class="tile-info">
    <h3 class="tile-title">{title}</h3>
    <p class="tile-desc">{role} · {summary}</p>
  </div>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    overflow: hidden;
    transition: transform var(--dur-med) var(--ease-out);
  }
  .tile:hover { transform: translateY(-4px); }
  .tile:hover .tile-title { color: var(--accent); }

  .tile-canvas {
    aspect-ratio: 4/5;
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1rem, 3vw, 3rem);
    border-radius: 8px;
    overflow: hidden;
  }
  .canvas-light { background: var(--canvas); border: 1px solid var(--rule); }
  .canvas-warm  { background: var(--canvas-warm); border: 1px solid #d9c6a8; }
  .canvas-dark  { background: var(--canvas-dark); border: 1px solid var(--canvas-dark); }

  /* ── MacBook Frame ── */
  .macbook {
    width: 95%;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .macbook-lid {
    width: 100%;
    background: #1d1d1f;
    border-radius: clamp(6px, 0.8vw, 12px) clamp(6px, 0.8vw, 12px) 0 0;
    padding: clamp(5px, 0.6vw, 10px) clamp(5px, 0.6vw, 10px) clamp(3px, 0.4vw, 6px);
  }

  .macbook-bezel { position: relative; }

  .macbook-camera {
    display: block;
    width: clamp(4px, 0.5vw, 6px);
    height: clamp(4px, 0.5vw, 6px);
    border-radius: 50%;
    background: #2a2a2c;
    margin: 0 auto clamp(3px, 0.4vw, 5px);
  }

  .macbook-screen {
    aspect-ratio: 16/10;
    overflow: hidden;
    border-radius: 2px;
    background: var(--canvas);
  }
  .macbook-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .macbook-hinge {
    width: 104%;
    height: clamp(3px, 0.4vw, 5px);
    background: linear-gradient(to bottom, #b8b8b8, #a0a0a0);
    border-radius: 0 0 1px 1px;
  }

  .macbook-base {
    width: 112%;
    background: linear-gradient(180deg, #c8c8c8 0%, #b0b0b0 40%, #a4a4a4 100%);
    border-radius: 0 0 clamp(4px, 0.6vw, 8px) clamp(4px, 0.6vw, 8px);
    padding: clamp(4px, 0.5vw, 8px) 10% clamp(5px, 0.6vw, 10px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2px, 0.3vw, 4px);
    position: relative;
  }
  .macbook-base::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 18%;
    height: 2px;
    background: #9a9a9a;
    border-radius: 0 0 3px 3px;
  }

  .macbook-keyboard {
    width: 92%;
    display: flex;
    flex-direction: column;
    gap: clamp(1px, 0.2vw, 3px);
  }
  .kb-row {
    height: clamp(3px, 0.4vw, 5px);
    background: linear-gradient(to right,
      transparent 0%, #8a8a8a 2%, #8a8a8a 98%, transparent 100%
    );
    border-radius: 1px;
    opacity: 0.5;
  }
  .kb-row-fn { height: clamp(2px, 0.25vw, 3px); }
  .kb-row-space { width: 60%; margin-inline: auto; }

  .macbook-trackpad {
    width: 38%;
    height: clamp(6px, 0.8vw, 14px);
    background: linear-gradient(180deg, #bbb 0%, #aaa 100%);
    border: 1px solid #999;
    border-radius: clamp(2px, 0.3vw, 4px);
    margin-top: clamp(1px, 0.2vw, 3px);
  }

  /* ── iPhone Frame (Dynamic Island) ── */
  .iphone {
    width: 55%;
    max-width: 280px;
  }
  .iphone-body {
    background: #1d1d1f;
    border-radius: clamp(18px, 3vw, 36px);
    padding: clamp(5px, 0.7vw, 10px);
    position: relative;
    border: 1px solid #333;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.08);
  }
  .iphone-island {
    position: absolute;
    top: clamp(10px, 1.5vw, 18px);
    left: 50%;
    transform: translateX(-50%);
    width: 26%;
    height: clamp(8px, 1.2vw, 16px);
    background: #000;
    border-radius: 100px;
    z-index: 2;
  }
  .iphone-screen {
    aspect-ratio: 9/19.5;
    overflow: hidden;
    border-radius: clamp(14px, 2.3vw, 28px);
    background: var(--canvas);
    position: relative;
  }
  .iphone-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .iphone-home {
    width: 32%;
    height: clamp(3px, 0.4vw, 4px);
    background: #555;
    border-radius: 3px;
    margin: clamp(4px, 0.5vw, 7px) auto clamp(3px, 0.4vw, 5px);
  }

  /* Placeholders */
  .macbook-placeholder, .iphone-placeholder { width: 100%; height: 100%; }
  .scheme-warm { background: linear-gradient(135deg, #efe3d0 0%, #d9c6a8 100%); }
  .scheme-cool { background: linear-gradient(135deg, #dce5ed 0%, #a8bdd5 100%); }
  .scheme-ink  { background: linear-gradient(135deg, #2a2a28 0%, #1a1a18 100%); }

  .tile-info {
    padding: clamp(1rem, 2vw, 1.5rem) 0.25rem;
  }
  .tile-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 48;
    font-weight: 600;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    letter-spacing: -0.02em;
    transition: color var(--dur-fast);
  }
  .tile:hover .tile-title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }
  .tile-desc {
    color: var(--ink-2);
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    margin-top: 0.5rem;
    line-height: 1.6;
    text-align: left;
    max-width: 50ch;
  }

  @media (max-width: 640px) {
    .tile-canvas { aspect-ratio: 3/4; }
    .macbook { width: 90%; }
    .iphone { width: 50%; }
  }
</style>

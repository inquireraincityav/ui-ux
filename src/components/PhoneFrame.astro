---
interface Props {
  src?: string;
  alt?: string;
  scheme?: 'warm' | 'cool' | 'ink';
  scale?: number;
}
const { src, alt = '', scheme = 'warm', scale = 0.55 } = Astro.props;
const hasSlot = Astro.slots.has('default');
---
<div class="phone" style={`--phone-scale:${scale}`}>
  <div class="phone-bezel">
    <div class="phone-notch" aria-hidden="true"></div>
    <div class="phone-screen">
      {src ? (
        <img src={src} alt={alt} loading="lazy" />
      ) : hasSlot ? (
        <slot />
      ) : (
        <div class:list={["phone-placeholder", `scheme-${scheme}`]} aria-hidden="true">
          <div class="ph-header"></div>
          <div class="ph-card"></div>
          <div class="ph-card short"></div>
          <div class="ph-nav">
            <span /><span /><span /><span />
          </div>
        </div>
      )}
    </div>
    <div class="phone-bar" aria-hidden="true"></div>
  </div>
</div>

<style>
  .phone {
    width: calc(var(--phone-scale, 0.55) * 100%);
    max-width: 280px;
    margin-inline: auto;
  }
  .phone-bezel {
    position: relative;
    background: #1a1a1a;
    border-radius: 2.4rem;
    padding: 0.75rem;
    box-shadow: 0 8px 30px rgba(0,0,0,0.18), inset 0 0 0 1px rgba(255,255,255,0.06);
  }
  .phone-notch {
    position: absolute;
    top: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: 35%;
    height: 1.6rem;
    background: #1a1a1a;
    border-radius: 0 0 1rem 1rem;
    z-index: 2;
  }
  .phone-screen {
    position: relative;
    border-radius: 1.8rem;
    overflow: hidden;
    aspect-ratio: 9/19.5;
    background: #fff;
  }
  .phone-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phone-bar {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 36%;
    height: 4px;
    background: rgba(255,255,255,0.3);
    border-radius: 4px;
  }

  .phone-placeholder {
    width: 100%; height: 100%;
    display: flex; flex-direction: column;
    padding: 3rem 1rem 1rem;
    gap: 0.6rem;
  }
  .scheme-warm { background: linear-gradient(160deg, #f5e6d0 0%, #efe3d0 100%); }
  .scheme-cool { background: linear-gradient(160deg, #dbe8f0 0%, #c8dae8 100%); }
  .scheme-ink  { background: linear-gradient(160deg, #2a2a2a 0%, #1a1a1a 100%); }
  .ph-header {
    height: 14%; border-radius: 0.5rem;
    background: rgba(0,0,0,0.08);
  }
  .scheme-ink .ph-header { background: rgba(255,255,255,0.08); }
  .ph-card {
    height: 22%; border-radius: 0.5rem;
    background: rgba(0,0,0,0.05);
  }
  .ph-card.short { height: 14%; }
  .scheme-ink .ph-card { background: rgba(255,255,255,0.05); }
  .ph-nav {
    margin-top: auto;
    display: flex; justify-content: space-around;
    padding: 0.5rem 0;
  }
  .ph-nav span {
    width: 20%; height: 4px; border-radius: 2px;
    background: rgba(0,0,0,0.1);
  }
  .scheme-ink .ph-nav span { background: rgba(255,255,255,0.1); }
</style>

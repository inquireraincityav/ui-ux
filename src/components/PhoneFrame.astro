---
interface Props {
  src?: string;
  alt?: string;
  scheme?: 'warm' | 'cool' | 'ink';
  scale?: number;
  caption?: string;
}
const { src, alt = '', scheme = 'warm', scale = 0.55, caption } = Astro.props;
const hasSlot = Astro.slots.has('default');
---
<figure class="phone-figure">
  <div class="phone" style={`--phone-scale:${scale}`}>
    <div class="phone-body">
      <div class="phone-screen">
        {src ? (
          <img src={src} alt={alt} loading="lazy" />
        ) : hasSlot ? (
          <slot />
        ) : (
          <div class:list={["phone-placeholder", `scheme-${scheme}`]} aria-hidden="true">
            <div class="ph-header"></div>
            <div class="ph-card"></div>
            <div class="ph-card short"></div>
            <div class="ph-nav">
              <span /><span /><span /><span />
            </div>
          </div>
        )}
      </div>
      <img class="phone-frame-img" src="/iphone-frame.png" alt="" aria-hidden="true" loading="lazy" />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .phone-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-block: 2rem;
  }
  .phone {
    width: 240px;
    margin-inline: auto;
  }
  .phone-body {
    position: relative;
    aspect-ratio: 501 / 1030;
    width: 100%;
  }
  .phone-screen {
    position: absolute;
    top: 1.6%;
    left: 1.6%;
    width: 96.8%;
    height: 96.6%;
    border-radius: 9.2%;
    overflow: hidden;
    background: #fff;
  }
  .phone-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .phone-frame-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 1;
  }

  figcaption {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--ink-3);
    line-height: 1.5;
    font-style: italic;
    text-align: center;
    max-width: 60ch;
    margin-inline: auto;
  }

  .phone-placeholder {
    width: 100%; height: 100%;
    display: flex; flex-direction: column;
    padding: 3rem 1rem 1rem;
    gap: 0.6rem;
  }
  .scheme-warm { background: linear-gradient(160deg, #f5e6d0 0%, #efe3d0 100%); }
  .scheme-cool { background: linear-gradient(160deg, #dbe8f0 0%, #c8dae8 100%); }
  .scheme-ink  { background: linear-gradient(160deg, #2a2a2a 0%, #1a1a1a 100%); }
  .ph-header {
    height: 14%; border-radius: 0.5rem;
    background: rgba(0,0,0,0.08);
  }
  .scheme-ink .ph-header { background: rgba(255,255,255,0.08); }
  .ph-card {
    height: 22%; border-radius: 0.5rem;
    background: rgba(0,0,0,0.05);
  }
  .ph-card.short { height: 14%; }
  .scheme-ink .ph-card { background: rgba(255,255,255,0.05); }
  .ph-nav {
    margin-top: auto;
    display: flex; justify-content: space-around;
    padding: 0.5rem 0;
  }
  .ph-nav span {
    width: 20%; height: 4px; border-radius: 2px;
    background: rgba(0,0,0,0.1);
  }
  .scheme-ink .ph-nav span { background: rgba(255,255,255,0.1); }
</style>

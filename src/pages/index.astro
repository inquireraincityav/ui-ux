---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const studies = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="SJAI Studio — UI/UX Portfolio">
  <Hero />

  <section id="work" class="work wrap">
    <div class="section-head">
      <p class="eyebrow">Work</p>
      <h2>Five projects worth reading in full.</h2>
    </div>

    <div class="cs-grid">
      {studies.map((s) => (
        <CaseStudyCard
          title={s.data.title}
          subtitle={s.data.subtitle}
          role={s.data.role}
          year={s.data.year}
          summary={s.data.summary}
          cover={s.data.cover}
          href={`${import.meta.env.BASE_URL}work/${s.slug}`}
          index={s.data.order}
          type={s.data.type}
          canvas={s.data.canvas}
          coverScheme={s.data.coverScheme}
        />
      ))}
    </div>
  </section>

  <section class="currently wrap">
    <hr class="rule" />
    <p class="eyebrow">Currently</p>
    <p class="currently-text">
      Taking on freelance and contract work for Q1 2026.
      <a href="mailto:inquire.raincityav@gmail.com">Say hello →</a>
    </p>
  </section>
</BaseLayout>

<style>
  .work { padding-block: 5rem 4rem; }
  .section-head { margin-bottom: 3rem; }
  .section-head h2 {
    margin-top: 0.75rem;
    max-width: 20ch;
    font-weight: 400;
  }

  .cs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 1.5rem;
  }
  @media (max-width: 1024px) {
    .cs-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .cs-grid { grid-template-columns: 1fr; }
  }

  .currently {
    padding-block: 0 6rem;
  }
  .currently .rule {
    border: 0;
    height: 1px;
    background: var(--rule);
    margin-bottom: 3rem;
  }
  .currently-text {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--step-2);
    color: var(--ink-2);
    margin-top: 1rem;
    max-width: 36ch;
  }
  .currently-text a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .currently-text a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

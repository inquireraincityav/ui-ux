---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const studies = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const blocks: (typeof studies)[] = [];
for (let i = 0; i < studies.length; i += 3) {
  blocks.push(studies.slice(i, i + 3));
}

const skills = [
  'Design Systems Architecture',
  'Prompt-Driven Design',
  'Information Architecture',
  'System Mapping',
  'Workflow Optimization',
  'User Research & Interviews',
  'Data Visualization',
];

const tools = [
  'Figma & FigJam (MCP)',
  'Adobe CC',
  'Framer',
  'HTML, CSS & JS',
  'ProtoPie',
  'Jira, Confluence, Basecamp',
  'OnShape',
  'Miro',
];

const experience = studies.map((s) => ({
  role: s.data.role,
  company: s.data.client,
  period: s.data.duration,
}));
---
<BaseLayout title="Jaival Shah - UI/UX Portfolio">
  <Hero />

  <section id="work" class="work wrap">
    <div class="work-header">
      <p class="eyebrow">Selected Work</p>
      <h2>Case Studies</h2>
      <p class="work-desc">
        Designing web and mobile experiences - from real estate marketing
        sites to accessibility-first mobile apps - with clarity, usability,
        and the person on the other end in mind.
      </p>
      <a href="#cs-grid" class="work-cta">Discover all projects</a>
    </div>

    <div class="cs-grid" id="cs-grid">
      {blocks.map((block, blockIdx) => (
        <div class:list={[
          "bento-block",
          blockIdx % 2 === 0 ? "even" : "odd",
          block.length < 3 && "partial",
        ]}>
          {block.map((s) => (
            <CaseStudyCard
              title={s.data.title}
              subtitle={s.data.subtitle}
              role={s.data.role}
              year={s.data.year}
              summary={s.data.summary}
              cover={s.data.cover}
              href={`${import.meta.env.BASE_URL}work/${s.slug}`}
              index={s.data.order}
              type={s.data.type}
              canvas={s.data.canvas}
              coverScheme={s.data.coverScheme}
            />
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="skills-section wrap">
    <div class="skills-row">
      <div class="skills-block">
        <span class="skills-label">Skill Set:</span>
        <div class="skills-content">
          {skills.map((s) => <p class="skill-item">{s}</p>)}
        </div>
      </div>
      <div class="skills-block">
        <span class="skills-label">Tools:</span>
        <div class="skills-content">
          {tools.map((t) => <p class="skill-item">{t}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="experience-section wrap">
    <div class="exp-table">
      <span class="exp-label">Experience:</span>
      <div class="exp-rows">
        {experience.map((e) => (
          <div class="exp-row">
            <span class="exp-role">{e.role}</span>
            <span class="exp-company">{e.company}</span>
            <span class="exp-period">{e.period}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .work { padding-block: clamp(3rem, 6vw, 6rem) clamp(2rem, 4vw, 4rem); }
  .work-header {
    text-align: left;
    max-width: 640px;
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }
  .work-header h2 {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 96;
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 4.5rem);
    margin-top: 0.5rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .work-desc {
    margin-top: 1.25rem;
    color: var(--ink-2);
    line-height: 1.7;
    text-align: left;
    font-size: clamp(0.85rem, 1.1vw, 1rem);
  }
  .work-cta {
    display: inline-block;
    margin-top: 1.75rem;
    padding: 0.7rem 1.6rem;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    border-radius: 4px;
    letter-spacing: 0.02em;
    transition: background var(--dur-fast);
  }
  .work-cta:hover {
    background: var(--accent);
    color: var(--paper);
  }

  /* ── Staggered Bento Grid ── */
  .cs-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 1vw, 0.9rem);
  }

  .bento-block {
    display: grid;
    gap: clamp(0.6rem, 1vw, 0.9rem);
    height: clamp(480px, 62vh, 700px);
  }

  /* Block type 1 (even): tall left, 2 wide right */
  .bento-block.even {
    grid-template-columns: 2fr 3fr;
    grid-template-rows: 1fr 1fr;
  }
  .bento-block.even > :global(:nth-child(1)) {
    grid-column: 1;
    grid-row: 1 / 3;
  }
  .bento-block.even > :global(:nth-child(2)) {
    grid-column: 2;
    grid-row: 1;
  }
  .bento-block.even > :global(:nth-child(3)) {
    grid-column: 2;
    grid-row: 2;
  }

  /* Block type 2 (odd): 2 wide left, tall right */
  .bento-block.odd {
    grid-template-columns: 3fr 2fr;
    grid-template-rows: 1fr 1fr;
  }
  .bento-block.odd > :global(:nth-child(1)) {
    grid-column: 1;
    grid-row: 1;
  }
  .bento-block.odd > :global(:nth-child(2)) {
    grid-column: 1;
    grid-row: 2;
  }
  .bento-block.odd > :global(:nth-child(3)) {
    grid-column: 2;
    grid-row: 1 / 3;
  }

  /* Partial blocks (fewer than 3 cards) */
  .bento-block.partial {
    height: clamp(300px, 40vh, 440px);
  }
  .bento-block.partial.even {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr;
  }
  .bento-block.partial.even > :global(:nth-child(1)) { grid-row: 1; }
  .bento-block.partial.even > :global(:only-child) { grid-column: 1 / -1; }
  .bento-block.partial.odd {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr;
  }
  .bento-block.partial.odd > :global(:nth-child(1)) { grid-row: 1; grid-column: 1; }
  .bento-block.partial.odd > :global(:nth-child(2)) { grid-row: 1; grid-column: 2; }
  .bento-block.partial.odd > :global(:only-child) { grid-column: 1 / -1; }

  /* Mobile: collapse to single column */
  @media (max-width: 768px) {
    .bento-block {
      grid-template-columns: 1fr !important;
      grid-template-rows: auto !important;
      height: auto !important;
    }
    .bento-block > :global(*) {
      grid-column: 1 !important;
      grid-row: auto !important;
      min-height: 300px;
    }
  }

  /* ── Skills Section (Bhalinder-style) ── */
  .skills-section {
    padding-block: clamp(3rem, 6vw, 6rem);
    border-top: 1px solid var(--rule);
  }
  .skills-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 6vw, 8rem);
  }
  .skills-block {
    display: grid;
    grid-template-columns: clamp(80px, 10vw, 120px) 1fr;
    gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
  }
  .skills-label {
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    color: var(--ink-3);
    font-weight: 400;
    padding-top: 0.1rem;
  }
  .skills-content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .skill-item {
    font-size: clamp(0.85rem, 1.1vw, 1.05rem);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.8;
    margin: 0;
    text-align: left;
  }

  /* ── Experience Section (Bhalinder-style) ── */
  .experience-section {
    padding-block: clamp(2rem, 4vw, 4rem) clamp(3rem, 6vw, 6rem);
  }
  .exp-table {
    display: grid;
    grid-template-columns: clamp(80px, 10vw, 120px) 1fr;
    gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
  }
  .exp-label {
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    color: var(--ink-3);
    font-weight: 400;
    padding-top: 1.25rem;
  }
  .exp-rows {
    display: flex;
    flex-direction: column;
  }
  .exp-row {
    display: grid;
    grid-template-columns: 1.2fr 1.5fr 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule-soft);
    align-items: baseline;
  }
  .exp-role {
    font-weight: 600;
    font-size: clamp(0.85rem, 1.1vw, 1.05rem);
    color: var(--ink);
  }
  .exp-company {
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    color: var(--ink-3);
  }
  .exp-period {
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    color: var(--ink-3);
    text-align: right;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .skills-row { gap: 3rem; }
    .skills-block { grid-template-columns: 1fr; gap: 0.5rem; }
    .exp-table { grid-template-columns: 1fr; gap: 0.5rem; }
  }
  @media (max-width: 640px) {
    .skills-row { grid-template-columns: 1fr; gap: 2.5rem; }
    .exp-row { grid-template-columns: 1fr; gap: 0.25rem; }
    .exp-period { text-align: left; }
  }

</style>

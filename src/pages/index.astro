---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const studies = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="SJAI Studio - UI/UX Portfolio">
  <Hero />

  <section id="work" class="work wrap">
    <div class="work-header">
      <p class="eyebrow">Selected Work</p>
      <h2>Case Studies</h2>
      <p class="work-desc">
        Designing web and mobile experiences - from real estate marketing
        sites to accessibility-first mobile apps - with clarity, usability,
        and the person on the other end in mind.
      </p>
      <a href="#cs-grid" class="work-cta">Discover all projects</a>
    </div>

    <div class="cs-grid" id="cs-grid">
      {studies.map((s) => (
        <CaseStudyCard
          title={s.data.title}
          subtitle={s.data.subtitle}
          role={s.data.role}
          year={s.data.year}
          summary={s.data.summary}
          cover={s.data.cover}
          href={`${import.meta.env.BASE_URL}work/${s.slug}`}
          index={s.data.order}
          type={s.data.type}
          canvas={s.data.canvas}
          coverScheme={s.data.coverScheme}
        />
      ))}
    </div>
  </section>

  <section class="currently wrap">
    <hr class="rule" />
    <p class="eyebrow">Currently</p>
    <p class="currently-text">
      Taking on freelance and contract work for Q1 2026.
      <a href="mailto:inquire.raincityav@gmail.com">Say hello &rarr;</a>
    </p>
  </section>
</BaseLayout>

<style>
  .work { padding-block: 6rem 4rem; }
  .work-header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: 5rem;
  }
  .work-header h2 {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 96;
    font-weight: 300;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-top: 0.5rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .work-desc {
    margin-top: 1.25rem;
    color: var(--ink-2);
    line-height: 1.7;
    margin-inline: auto;
    text-align: center;
  }
  .work-cta {
    display: inline-block;
    margin-top: 1.75rem;
    padding: 0.7rem 1.6rem;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    border-radius: 4px;
    letter-spacing: 0.02em;
    transition: background var(--dur-fast);
  }
  .work-cta:hover {
    background: var(--accent);
    color: var(--paper);
  }

  .cs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 1.75rem;
  }
  @media (max-width: 1024px) {
    .cs-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .cs-grid { grid-template-columns: 1fr; }
  }

  .currently {
    padding-block: 0 6rem;
  }
  .currently .rule {
    border: 0;
    height: 1px;
    background: var(--rule);
    margin-bottom: 3rem;
  }
  .currently-text {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--step-2);
    color: var(--ink-2);
    margin-top: 1rem;
    max-width: 36ch;
  }
  .currently-text a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .currently-text a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

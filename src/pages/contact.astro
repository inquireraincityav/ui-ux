---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Contact - Jaival Shah" description="Get in touch for design collaborations, freelance work, or just to say hello.">
  <section class="contact-page">
    <div class="contact-grid wrap">
      <div class="contact-label">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 2L11 13" /><path d="M22 2L15 22L11 13L2 9L22 2Z" />
        </svg>
        <span>Say Hello</span>
      </div>

      <div class="contact-main">
        <h1>Let's Connect</h1>
        <p class="contact-intro">
          Whether it's about a design project, a collaboration,
          or just a good conversation about UX, sports or vacation spots, I'd love to hear from you.
        </p>

        <form
          class="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value="83e59772-32b0-4def-9c1b-e1c86758396f" />
          <input type="hidden" name="subject" value="New message from jaivalshah.com" />
          <input type="hidden" name="from_name" value="Portfolio Contact Form" />
          <input type="checkbox" name="botcheck" style="display: none;" />

          <div class="form-group">
            <label for="name">Name <span class="required">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="What's your name?"
              required
            />
          </div>

          <div class="form-group">
            <label for="email">E-mail <span class="required">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="Your best email address"
              required
            />
          </div>

          <div class="form-group">
            <label for="message">Message</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              placeholder="Tell me a bit about what you're looking for"
            ></textarea>
          </div>

          <button type="submit" class="submit-btn">Send message</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    padding-block: clamp(3rem, 6vw, 6rem) clamp(4rem, 8vw, 8rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: clamp(120px, 15vw, 200px) 1fr;
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .contact-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    font-size: clamp(0.85rem, 1vw, 0.95rem);
    font-weight: 600;
    padding-top: 0.5rem;
  }

  .contact-main {
    max-width: 720px;
  }

  .contact-main h1 {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 96;
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
  }

  .contact-intro {
    margin-top: 1.25rem;
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 480px;
    text-align: left;
  }

  .contact-form {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: clamp(0.8rem, 0.95vw, 0.9rem);
    color: var(--ink-3);
    font-weight: 500;
  }

  .required {
    color: var(--accent);
  }

  .form-group input,
  .form-group textarea {
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    color: var(--ink);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--rule);
    padding: 0.75rem 0;
    outline: none;
    transition: border-color 0.2s;
    resize: vertical;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--ink-4);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-bottom-color: var(--ink);
  }

  .form-group textarea {
    min-height: 120px;
  }

  .submit-btn {
    margin-top: 1rem;
    padding: 1rem 2rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1vw, 1rem);
    font-weight: 500;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    letter-spacing: 0.01em;
  }

  .submit-btn:hover {
    background: var(--accent);
    transform: translateY(-1px);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>

<script>
  const form = document.querySelector('.contact-form') as HTMLFormElement;
  const btn = form?.querySelector('.submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.textContent = 'Sending...';
    btn.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
      });
      const data = await res.json();

      if (data.success) {
        btn.textContent = 'Sent!';
        form.reset();
        setTimeout(() => {
          btn.textContent = 'Send message';
          btn.disabled = false;
        }, 3000);
      } else {
        btn.textContent = 'Something went wrong';
        btn.disabled = false;
      }
    } catch {
      btn.textContent = 'Something went wrong';
      btn.disabled = false;
    }
  });
</script>

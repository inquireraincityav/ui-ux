---
import BaseLayout from '../layouts/BaseLayout.astro';
import Character from '../components/Character.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="About — Your Name" description="A short introduction and how I work.">
  <section class="about wrap">
    <div class="about-grid">
      <div class="about-copy">
        <p class="eyebrow">About the studio</p>
        <h1>A short bio in your voice, one paragraph.</h1>
        <p class="lede">
          Two or three sentences on what you do, who you do it for, and what makes
          your approach different. Replace with your own words.
        </p>

        <hr class="rule" />

        <h3>How I got here</h3>
        <p>A paragraph on the arc — where you started, what you did between then and
        now, and the thing that changed how you think about design.</p>

        <h3>What I look for in a project</h3>
        <p>Be specific. What kinds of problems, at what stage of company, in what
        industries? Portfolios that hedge get contacted by nobody.</p>

        <h3>Outside work</h3>
        <p>One or two sentences of personality. What you read, make, or care about.
        Skip if it feels forced.</p>
      </div>

      <aside class="about-side">
        <div class="side-portrait">
          <Character
            size={280}
            poses={{
              front: `${base}character/idle-front.png`,
              left: `${base}character/three-quarter-left.png`,
              right: `${base}character/three-quarter-right.png`,
              wave: `${base}character/waving.png`,
            }}
            alt="Portrait"
          />
        </div>
        <dl class="fact-list">
          <div><dt>Based in</dt><dd>[City, Country]</dd></div>
          <div><dt>Available</dt><dd>Freelance / Contract</dd></div>
          <div><dt>Speaks</dt><dd>English, [...]</dd></div>
          <div><dt>Reading now</dt><dd>[book title]</dd></div>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .about { padding-block: 4rem 6rem; }
  .about-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 5rem;
    align-items: start;
  }
  .about-copy h1 {
    margin-top: 1rem;
    max-width: 22ch;
  }
  .about-copy .lede {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 24;
    font-weight: 400;
    font-size: var(--step-2);
    color: var(--ink-2);
    line-height: 1.3;
    max-width: 34ch;
  }
  .about-copy h3 {
    margin-top: 3rem;
    margin-bottom: 0.75rem;
  }
  .about-copy p { color: var(--ink-2); margin-block: 0.75rem; line-height: 1.65; }

  .about-side {
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .side-portrait {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 2rem;
    display: flex; justify-content: center;
  }
  .fact-list {
    margin: 0;
    display: flex; flex-direction: column;
    border-top: 1px solid var(--rule);
  }
  .fact-list > div {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .fact-list dt {
    font-size: var(--step--2);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .fact-list dd {
    margin: 0;
    text-align: right;
    color: var(--ink);
    font-size: var(--step-0);
  }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
    .about-side { position: static; }
  }
</style>

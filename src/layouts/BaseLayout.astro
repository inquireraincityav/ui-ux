---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "UI/UX portfolio - web and mobile product design." } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@300..800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <title>{title}</title>
  </head>
  <body>
    <video
      class="page-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    >
      <source src={`${base}purple-bg.mp4`} type="video/mp4" />
    </video>
    <div class="page-overlay" aria-hidden="true"></div>

    <a class="sr-only" href="#main">Skip to content</a>

    <header class="site-header wrap">
      <a href={base} class="brand">
        <span class="brand-mark" aria-hidden="true">·</span>
        <span class="brand-name">Jaival Shah</span>
      </a>
      <nav aria-label="Primary" class="primary-nav">
        <a href={`${base}#work`}>Work</a>
        <a href={`${base}about`}>About</a>
        <a href="mailto:jaival.shah2@gmail.com">Contact</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <div class="foot-grid">
        <div>
          <p class="eyebrow">Contact</p>
          <ul class="links">
            <li><a href="mailto:jaival.shah2@gmail.com">jaival.shah2@gmail.com</a></li>
            <li><a href="https://www.instagram.com/itsjaival/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></li>
            <li><a href="#">Read.cv ↗</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Under the Hood</p>
          <p class="small">Typeset in Lexend & Inter. Handcrafted with Astro. Designed, broken, rebuilt, and shipped from Vancouver.</p>
        </div>
      </div>
      <p class="small copy">© {new Date().getFullYear()} · Jaival Shah</p>
    </footer>

    <style>
      .page-video {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -2;
      }
      .page-overlay {
        position: fixed;
        inset: 0;
        background: rgba(245, 244, 240, 0.82);
        z-index: -1;
      }
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 1.5rem 1rem;
        gap: 1.5rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        color: var(--ink);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: -0.02em;
      }
      .brand-mark {
        display: grid; place-items: center;
        width: 24px; height: 24px;
        background: var(--ink);
        color: var(--paper);
        border-radius: 50%;
        font-size: 0.75rem;
        line-height: 1;
        transform: translateY(-1px);
      }
      .primary-nav {
        display: flex;
        gap: 2rem;
        font-size: 0.9rem;
      }
      .primary-nav a {
        text-decoration: none;
        color: var(--ink);
        opacity: 0.55;
        transition: opacity var(--dur-fast);
      }
      .primary-nav a:hover { opacity: 1; color: var(--ink); }

      @media (max-width: 640px) {
        .primary-nav { gap: 1.25rem; font-size: 0.85rem; }
      }

      .site-footer {
        margin-top: 8rem;
        padding-block: 3rem 2rem;
        border-top: 1px solid var(--rule);
      }
      .foot-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        margin-bottom: 2.5rem;
      }
      .foot-grid .links {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        font-size: 0.9rem;
      }
      .foot-grid .links a {
        text-decoration: none;
        color: var(--ink);
      }
      .foot-grid .links a:hover { color: var(--accent); }
      .small { font-size: var(--step--1); color: var(--ink-3); }
      .copy { padding-top: 1rem; border-top: 1px solid var(--rule-soft); }
      @media (max-width: 640px) {
        .foot-grid { grid-template-columns: 1fr; gap: 2rem; }
      }
    </style>

    <nav class="float-pill" aria-label="Quick navigation">
      <button class="pill-btn" id="scroll-top" aria-label="Scroll to top">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 13V3M3.5 7L8 2.5L12.5 7"/>
        </svg>
      </button>
      <span class="pill-divider" aria-hidden="true"></span>
      <a class="pill-btn" href={base} aria-label="Go to homepage">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2.5 8.5V13a1 1 0 001 1h9a1 1 0 001-1V8.5M1.5 7L8 1.5L14.5 7"/>
        </svg>
      </a>
    </nav>

    <style>
      .float-pill {
        position: fixed;
        bottom: clamp(1.25rem, 3vw, 2rem);
        right: clamp(1.25rem, 3vw, 2rem);
        display: flex;
        align-items: center;
        gap: 0;
        background: rgba(245, 244, 240, 0.7);
        -webkit-backdrop-filter: blur(14px) saturate(1.6);
        backdrop-filter: blur(14px) saturate(1.6);
        border: 1px solid rgba(15, 15, 14, 0.08);
        border-radius: 999px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06), 0 0 0 0.5px rgba(0,0,0,0.03);
        z-index: 900;
        padding: 0.3rem;
      }
      .pill-btn {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: none;
        background: transparent;
        color: var(--ink);
        opacity: 0.5;
        cursor: pointer;
        border-radius: 50%;
        text-decoration: none;
        transition: opacity 0.2s, background 0.2s, transform 0.2s;
      }
      .pill-btn:hover {
        opacity: 1;
        background: rgba(15, 15, 14, 0.06);
        transform: scale(1.1);
      }
      .pill-divider {
        width: 1px;
        height: 18px;
        background: rgba(15, 15, 14, 0.1);
        flex-shrink: 0;
      }
      @media (max-width: 640px) {
        .float-pill {
          bottom: 1.25rem;
          right: 1rem;
        }
        .pill-btn { width: 32px; height: 32px; }
        .pill-btn svg { width: 14px; height: 14px; }
        .pill-divider { height: 14px; }
      }
    </style>

    <script>
      document.getElementById('scroll-top')?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>

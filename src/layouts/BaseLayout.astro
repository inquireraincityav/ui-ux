---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "UI/UX portfolio — case studies, breakdowns, and thinking." } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />

    {/* Type: warm serif display + clean sans body */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,30..100&family=Inter:wght@400;500;600;700&display=swap"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <title>{title}</title>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>

    <header class="site-header wrap">
      <a href={import.meta.env.BASE_URL} class="brand">
        <span class="brand-mark" aria-hidden="true">◐</span>
        <span class="brand-name">Your Name</span>
      </a>
      <nav aria-label="Primary">
        <a href={`${import.meta.env.BASE_URL}#work`}>Work</a>
        <a href={`${import.meta.env.BASE_URL}#process`}>Process</a>
        <a href={`${import.meta.env.BASE_URL}about`}>About</a>
        <a href="mailto:inquire.raincityav@gmail.com" class="pill">Get in touch</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <div class="foot-grid">
        <div>
          <p class="eyebrow">Elsewhere</p>
          <ul class="links">
            <li><a href="#">LinkedIn</a></li>
            <li><a href="#">Read.cv</a></li>
            <li><a href="#">Dribbble</a></li>
            <li><a href="mailto:inquire.raincityav@gmail.com">Email</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Colophon</p>
          <p class="small">Set in Fraunces &amp; Inter. Built with Astro. Hand-tuned in {new Date().getFullYear()}.</p>
        </div>
      </div>
      <p class="small copy">© {new Date().getFullYear()} — designed and coded from scratch.</p>
    </footer>

    <script>
      // Respect saved preference; otherwise follow system.
      const saved = localStorage.getItem('theme');
      if (saved === 'dark' || saved === 'light') {
        document.documentElement.setAttribute('data-theme', saved);
      }
    </script>

    <style>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 1.5rem 1rem;
        gap: 1.5rem;
      }
      .brand {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        text-decoration: none;
        font-family: var(--font-display);
        font-size: var(--step-1);
        letter-spacing: -0.01em;
      }
      .brand-mark {
        display: inline-block;
        color: var(--accent);
        transform: translateY(2px);
      }
      nav[aria-label="Primary"] {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        font-size: var(--step--1);
      }
      nav a { text-decoration: none; color: var(--ink-2); }
      nav a:hover { color: var(--ink); }
      nav a.pill {
        border: 1px solid var(--ink);
        color: var(--ink);
        padding: 0.5rem 0.9rem;
        border-radius: 999px;
        transition: background var(--dur-fast), color var(--dur-fast);
      }
      nav a.pill:hover { background: var(--ink); color: var(--paper); }

      @media (max-width: 640px) {
        nav[aria-label="Primary"] { gap: 1rem; }
        nav a.pill { padding: 0.4rem 0.7rem; }
      }

      .site-footer {
        margin-top: 6rem;
        padding-block: 3rem 2rem;
        border-top: 1px solid var(--rule);
      }
      .foot-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-bottom: 2rem;
      }
      .foot-grid .links {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }
      .small { font-size: var(--step--1); color: var(--ink-3); }
      .copy { text-align: center; padding-top: 1rem; border-top: 1px dashed var(--rule); }
      @media (max-width: 640px) {
        .foot-grid { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>

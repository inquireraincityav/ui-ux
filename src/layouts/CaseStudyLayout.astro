---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    role: string;
    year: string;
    summary: string;
    client?: string;
    duration?: string;
    tools?: string[];
    outcomes?: string[];
    accent?: string;
    order: number;
  };
}
const { frontmatter } = Astro.props;
const accent = frontmatter.accent ?? 'var(--accent)';
---
<BaseLayout title={`${frontmatter.title} — Case Study`} description={frontmatter.summary}>
  <article class="cs" style={`--cs-accent:${accent}`}>
    <header class="cs-hero wrap">
      <a class="back" href={import.meta.env.BASE_URL + '#work'}>← All work</a>
      <p class="eyebrow">Case study {String(frontmatter.order).padStart(2, '0')} · {frontmatter.year}</p>
      <h1>{frontmatter.title}</h1>
      <p class="cs-summary">{frontmatter.summary}</p>

      <dl class="cs-meta-grid">
        <div><dt>Role</dt><dd>{frontmatter.role}</dd></div>
        {frontmatter.client && <div><dt>Client</dt><dd>{frontmatter.client}</dd></div>}
        {frontmatter.duration && <div><dt>Duration</dt><dd>{frontmatter.duration}</dd></div>}
        {frontmatter.tools && frontmatter.tools.length > 0 && (
          <div><dt>Tools</dt><dd>{frontmatter.tools.join(' · ')}</dd></div>
        )}
      </dl>
    </header>

    <div class="cs-body wrap">
      <slot />
    </div>

    {frontmatter.outcomes && frontmatter.outcomes.length > 0 && (
      <section class="cs-outcomes wrap">
        <p class="eyebrow">What changed</p>
        <ul>
          {frontmatter.outcomes.map((o) => <li>{o}</li>)}
        </ul>
      </section>
    )}
  </article>

  <style>
    .cs { padding-block: 2rem 4rem; }
    .cs-hero { padding-block: 3rem 4rem; border-bottom: 1px solid var(--rule); }
    .back {
      display: inline-block;
      font-size: var(--step--1);
      color: var(--ink-3);
      text-decoration: none;
      margin-bottom: 2rem;
    }
    .back:hover { color: var(--ink); }
    .cs-hero h1 { margin-top: 0.75rem; max-width: 20ch; }
    .cs-hero h1::first-letter { color: var(--cs-accent); }
    .cs-summary { font-size: var(--step-1); color: var(--ink-2); margin-top: 1.5rem; max-width: 60ch; }
    .cs-meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 1.5rem 2rem;
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px dashed var(--rule);
    }
    .cs-meta-grid dt {
      font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--ink-3); margin-bottom: 0.35rem;
    }
    .cs-meta-grid dd { margin: 0; font-weight: 500; color: var(--ink); }

    .cs-body { padding-block: 3rem; max-width: 780px; }
    .cs-body :global(h2) {
      font-size: var(--step-4);
      margin-top: 3rem;
      margin-bottom: 1rem;
    }
    .cs-body :global(h2::before) {
      content: '';
      display: block;
      width: 40px;
      height: 3px;
      background: var(--cs-accent);
      margin-bottom: 1rem;
    }
    .cs-body :global(h3) { margin-top: 2rem; margin-bottom: 0.75rem; font-size: var(--step-2); }
    .cs-body :global(p) { margin-block: 1rem; color: var(--ink-2); }
    .cs-body :global(p strong) { color: var(--ink); }
    .cs-body :global(blockquote) {
      border-left: 3px solid var(--cs-accent);
      padding-left: 1.25rem;
      margin-block: 2rem;
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--step-2);
      color: var(--ink);
    }
    .cs-body :global(figure.baf) { margin-inline: calc(-1 * var(--gutter)); }
    @media (min-width: 900px) {
      .cs-body :global(figure.baf) { margin-inline: -3rem; }
    }
    .cs-body :global(ul), .cs-body :global(ol) { padding-left: 1.5rem; color: var(--ink-2); }
    .cs-body :global(li) { margin-block: 0.5rem; }
    .cs-body :global(hr) { border: 0; height: 1px; background: var(--rule); margin-block: 3rem; }

    .cs-outcomes {
      padding: 2.5rem;
      margin-top: 3rem;
      background: var(--paper-2);
      border-radius: 8px;
      border-left: 4px solid var(--cs-accent);
    }
    .cs-outcomes ul {
      list-style: none;
      padding: 0;
      margin-top: 1rem;
      display: grid;
      gap: 0.75rem;
    }
    .cs-outcomes li {
      padding-left: 1.75rem;
      position: relative;
      font-size: var(--step-1);
    }
    .cs-outcomes li::before {
      content: '↳';
      position: absolute; left: 0; top: 0;
      color: var(--cs-accent);
      font-weight: 700;
    }
  </style>
</BaseLayout>

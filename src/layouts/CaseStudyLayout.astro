---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    subtitle?: string;
    role: string;
    year: string;
    summary: string;
    client?: string;
    duration?: string;
    tools?: string[];
    outcomes?: string[];
    order: number;
    type?: 'web' | 'mobile' | 'both';
  };
}
const { frontmatter } = Astro.props;
const num = String(frontmatter.order).padStart(2, '0');
const typeLabel =
  frontmatter.type === 'both' ? 'Web + Mobile'
  : frontmatter.type === 'mobile' ? 'Mobile'
  : 'Web';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${frontmatter.title} — Case Study`} description={frontmatter.summary}>
  <article class="cs">
    <header class="cs-hero wrap">
      <a class="back" href={`${base}#work`}>← Back to index</a>

      <div class="cs-head-grid">
        <div class="cs-index">
          <span class="index-num">№ {num}</span>
        </div>
        <div class="cs-title-block">
          <p class="eyebrow">Case study · {typeLabel} · {frontmatter.year}</p>
          <h1>{frontmatter.title}</h1>
          {frontmatter.subtitle && <p class="cs-subtitle">{frontmatter.subtitle}</p>}
          <p class="cs-summary">{frontmatter.summary}</p>
        </div>
      </div>

      <dl class="cs-meta-grid">
        <div><dt>Role</dt><dd>{frontmatter.role}</dd></div>
        {frontmatter.client && <div><dt>Client</dt><dd>{frontmatter.client}</dd></div>}
        {frontmatter.duration && <div><dt>Duration</dt><dd>{frontmatter.duration}</dd></div>}
        {frontmatter.tools && frontmatter.tools.length > 0 && (
          <div><dt>Tools</dt><dd>{frontmatter.tools.join(' · ')}</dd></div>
        )}
      </dl>
    </header>

    <div class="cs-body wrap">
      <slot />
    </div>

    {frontmatter.outcomes && frontmatter.outcomes.length > 0 && (
      <section class="cs-outcomes wrap">
        <p class="eyebrow">What changed</p>
        <ul>
          {frontmatter.outcomes.map((o) => <li>{o}</li>)}
        </ul>
      </section>
    )}

    <nav class="cs-nav wrap">
      <a href={`${base}#work`}>← Back to index</a>
      <a href="mailto:inquire.raincityav@gmail.com">Get in touch →</a>
    </nav>
  </article>

  <style>
    .cs { padding-block: 2rem 4rem; }
    .cs-hero { padding-block: 3rem 4rem; border-bottom: 1px solid var(--rule); }
    .back {
      display: inline-block;
      font-size: var(--step--1);
      color: var(--ink-3);
      text-decoration: none;
      margin-bottom: 3rem;
    }
    .back:hover { color: var(--ink); }

    .cs-head-grid {
      display: grid;
      grid-template-columns: 1fr 3fr;
      gap: 3rem;
      align-items: start;
    }
    .cs-index .index-num {
      font-family: var(--font-display);
      font-optical-sizing: auto;
      font-variation-settings: "opsz" 48;
      font-weight: 300;
      font-size: clamp(2rem, 4vw, 3rem);
      color: var(--ink-3);
      letter-spacing: -0.02em;
    }
    .cs-title-block h1 {
      margin: 0.75rem 0 0.75rem;
      font-family: var(--font-display);
      font-optical-sizing: auto;
      font-variation-settings: "opsz" 96;
      font-weight: 300;
      font-size: clamp(2.5rem, 5.5vw, 4.5rem);
      line-height: 1;
      letter-spacing: -0.03em;
      max-width: 20ch;
      text-wrap: balance;
    }
    .cs-subtitle {
      font-family: var(--font-display);
      font-optical-sizing: auto;
      font-variation-settings: "opsz" 24;
      font-weight: 400;
      font-size: var(--step-2);
      color: var(--ink-3);
      line-height: 1.2;
      margin-top: 0.5rem;
    }
    .cs-summary {
      font-size: var(--step-1);
      color: var(--ink-2);
      line-height: 1.55;
      margin-top: 1.5rem;
      max-width: 58ch;
    }

    .cs-meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1.5rem 2rem;
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--rule);
    }
    .cs-meta-grid dt {
      font-size: var(--step--2);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--ink-3);
      margin-bottom: 0.4rem;
    }
    .cs-meta-grid dd {
      margin: 0;
      font-weight: 500;
      color: var(--ink);
      font-size: var(--step-0);
    }

    .cs-body { padding-block: 4rem; max-width: 780px; }
    .cs-body :global(h2) {
      font-family: var(--font-display);
      font-optical-sizing: auto;
      font-variation-settings: "opsz" 48;
      font-weight: 400;
      font-size: var(--step-4);
      margin-top: 3.5rem;
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
      line-height: 1.05;
    }
    .cs-body :global(h3) {
      font-family: var(--font-display);
      font-optical-sizing: auto;
      font-variation-settings: "opsz" 24;
      font-weight: 500;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      font-size: var(--step-2);
    }
    .cs-body :global(p) { margin-block: 1rem; color: var(--ink-2); line-height: 1.7; }
    .cs-body :global(p strong) { color: var(--ink); font-weight: 600; }
    .cs-body :global(blockquote) {
      border-left: 2px solid var(--accent);
      padding-left: 1.25rem;
      margin-block: 2rem;
      font-family: var(--font-display);
      font-optical-sizing: auto;
      font-variation-settings: "opsz" 32;
      font-weight: 400;
      font-style: normal;
      font-size: var(--step-2);
      color: var(--ink);
      line-height: 1.3;
    }
    .cs-body :global(figure.baf) { margin-inline: calc(-1 * var(--gutter)); }
    @media (min-width: 900px) {
      .cs-body :global(figure.baf) { margin-inline: -3rem; }
    }
    .cs-body :global(ul), .cs-body :global(ol) { padding-left: 1.5rem; color: var(--ink-2); }
    .cs-body :global(li) { margin-block: 0.5rem; }
    .cs-body :global(hr) { border: 0; height: 1px; background: var(--rule); margin-block: 3rem; }

    .cs-outcomes {
      padding: 3rem;
      margin-top: 2rem;
      background: var(--paper-2);
      border-radius: 4px;
      border-left: 2px solid var(--accent);
    }
    .cs-outcomes ul {
      list-style: none;
      padding: 0;
      margin-top: 1rem;
      display: grid;
      gap: 0.75rem;
    }
    .cs-outcomes li {
      padding-left: 1.75rem;
      position: relative;
      font-size: var(--step-1);
      font-family: var(--font-display);
      font-optical-sizing: auto;
      font-variation-settings: "opsz" 18;
      font-weight: 400;
    }
    .cs-outcomes li::before {
      content: "→";
      position: absolute; left: 0; top: 0;
      color: var(--accent);
      font-weight: 700;
    }

    .cs-nav {
      display: flex;
      justify-content: space-between;
      margin-top: 5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--rule);
      font-size: var(--step-0);
    }
    .cs-nav a { color: var(--ink); text-decoration: none; }
    .cs-nav a:hover { color: var(--accent); }

    @media (max-width: 820px) {
      .cs-head-grid { grid-template-columns: 1fr; gap: 1rem; }
    }
  </style>
</BaseLayout>
